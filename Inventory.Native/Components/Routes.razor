@using Inventory.SharedUI.Services
@inject UserStateService UserState
@inject NavigationManager Navigation

<Router AppAssembly="@typeof(MauiProgram).Assembly"
        AdditionalAssemblies="new[] { typeof(Inventory.RazorLib.Pages.InventoryDashboard).Assembly }"
        OnNavigateAsync="HandleNavigationAsync">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(Layout.MainLayout)">
            <p class="p-3">No se encontró la página solicitada.</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private static readonly string[] AnonymousRoutes = new[]
    {
        "/",
        "/login",
        "/servidor"
    };

    private async Task HandleNavigationAsync(NavigationContext context)
    {
        var path = NormalizePath(context.Path);
        if (AnonymousRoutes.Contains(path, StringComparer.OrdinalIgnoreCase))
        {
            return;
        }

        var currentUser = await UserState.GetCurrentUserAsync();
        if (currentUser == null)
        {
            Navigation.NavigateTo("/login", true);
        }
    }

    private static string NormalizePath(string path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return "/";
        }

        var normalized = path.StartsWith('/') ? path : "/" + path;
        if (normalized.EndsWith('/'))
        {
            normalized = normalized.TrimEnd('/');
        }

        return normalized;
    }
}

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Inventory.Native"
             xmlns:components="clr-namespace:Inventory.Native.Components"
             xmlns:b="clr-namespace:Microsoft.AspNetCore.Components.WebView.Maui;assembly=Microsoft.AspNetCore.Components.WebView.Maui"
             x:Class="Inventory.Native.MainPage"
             BackgroundColor="#03173d">

    <RefreshView x:Name="pageRefresh" RefreshColor="White" Refreshing="RefreshView_Refreshing">
        <b:BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
            <b:BlazorWebView.RootComponents>
                <b:RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </b:BlazorWebView.RootComponents>
        </b:BlazorWebView>
    </RefreshView>

</ContentPage>

# .gitignore for InventorySolution
# Generated by assistant — ignore common build, IDE, and OS files

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Bb]in/
[Oo]bj/
**/bin/
**/obj/
**/Debug*/
**/Release*/

# Rider
.idea/
*.sln.iml

# NuGet
*.nupkg
packages/
*.snupkg

# ASP.NET static web assets & publish outputs
wwwroot/service-worker-assets.js
**/wwwroot/_content/
publish/

# Node
node_modules/
npm-debug.log
yarn-error.log

# VS Code
.vscode/
.history/

# ReSharper
_ReSharper*/
*.DotSettings.user

# User-specific files
*.user
*.userprefs
*.suo
*.ntvs_analysis.dat
*.vspscc

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# Secrets and env
.env
secrets.json
appsettings.*.Local.json

# Database files
*.db
*.sqlite

# Generated files
artifacts/
*.cache

# Ignore build outputs in project folders (explicit examples)
Inventory.API/bin/
Inventory.API/obj/
Inventory.APP/bin/
Inventory.APP/obj/
Inventory.Core/bin/
Inventory.Core/obj/
Inventory.RazorLib/bin/
Inventory.RazorLib/obj/

# Ignore JetBrains Rider caches
.idea/
*.sln.iml

# Git tooling
.vscode-test/

# End of .gitignore

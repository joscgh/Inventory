@using Inventory.Core.Classes
@inject Inventory.RazorLib.Services.UserStateService UserState

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Inventory.APP</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column text-nowrap">
        @if (currentUser != null)
        {
            <div class="nav-item px-3 text-white py-2">
                <small>Conectado como:</small>
                <div><strong>@currentUser.FullName</strong></div>
                <div class="text-muted">@currentUser.Email</div>
            </div>
        }
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        @if (currentUser != null)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="inventory">
                    <span class="bi bi-box-seam-fill-nav-menu" aria-hidden="true"></span> Inventory Dashboard
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="nota-entrega">
                    <span class="bi bi-receipt-cutoff-nav-menu" aria-hidden="true"></span> Nota de Entrega
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="nota-pedido">
                    <span class="bi bi-file-earmark-text-fill-nav-menu" aria-hidden="true"></span> Nota de Pedido
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="notas">
                    <span class="bi bi-list-ul-nav-menu" aria-hidden="true"></span> Lista de Notas
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="inventory/history">
                    <span class="bi bi-clock-history-nav-menu" aria-hidden="true"></span> Historial de inventario
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="reports/sales">
                    <span class="bi bi-bar-chart-fill-nav-menu" aria-hidden="true"></span> Reportes de ventas
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="categories">
                    <span class="bi bi-tags-fill-nav-menu" aria-hidden="true"></span> Categories
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="currencies">
                    <span class="bi bi-currency-exchange-nav-menu" aria-hidden="true"></span> Currencies
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="taxes">
                    <span class="bi bi-receipt-cutoff-nav-menu" aria-hidden="true"></span> Taxes
                </NavLink>
            </div>
        }
        @if (currentUser != null)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="customer-accounts">
                    <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Cuentas de Cliente
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="account-locations">
                    <span class="bi bi-shop-nav-menu" aria-hidden="true"></span> Depósitos y Tiendas
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="customer-account-users">
                    <span class="bi bi-person-lines-fill-nav-menu" aria-hidden="true"></span> Usuarios de Cuenta
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="logout">
                    <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Cerrar sesión
                </NavLink>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-box-arrow-in-right-nav-menu" aria-hidden="true"></span> Iniciar sesión
                </NavLink>
            </div>
        }
      
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private LoginResponse? currentUser;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override async Task OnInitializedAsync()
    {
        currentUser = await UserState.GetCurrentUserAsync();
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}

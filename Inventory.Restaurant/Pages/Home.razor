@page "/"
@inject HttpClient Http

<PageTitle>Comandas | Inventory.Restaurant</PageTitle>

<div class="restaurant-app">
    <header class="topbar">
        <a class="brand" href="/" aria-label="Inventory Restaurant inicio">
            <span class="brand-mark">IR</span>
            <span><strong>Inventario</strong><small>RESTAURANTE</small></span>
        </a>
        <div class="topbar-center"><span class="live-dot"></span><span>@(isLoading ? "Conectando" : errorMessage is null ? "Servicio activo" : "Sin conexión")</span></div>
        <div class="topbar-right"><span class="date-label">@DateTime.Now.ToString("dddd, dd MMMM")</span><button class="icon-button" title="Actualizar" aria-label="Actualizar" @onclick="LoadAsync">↻</button></div>
    </header>

    <main class="content">
        <section class="page-heading">
            <div><div class="eyebrow">SERVICIO · TURNO ACTUAL</div><h1>Comandas</h1><p class="subtitle">Sala y cocina, en un solo lugar.</p></div>
            <div class="shift-stats">
                <div><strong>@ActiveOrders.Count</strong><span>abiertas</span></div>
                <div><strong>@ReadyOrders.Count</strong><span>listas</span></div>
                <div class="view-switch" role="tablist" aria-label="Vista de trabajo">
                    <button class="@(activeView == "floor" ? "selected" : "")" @onclick="ShowFloor">Sala</button>
                    <button class="@(activeView == "kitchen" ? "selected" : "")" @onclick="ShowKitchen">Cocina</button>
                    <button class="@(activeView == "admin" ? "selected" : "")" @onclick="ShowAdmin">Administrar</button>
                </div>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="connection-alert" role="alert"><span>@errorMessage</span><button @onclick="LoadAsync">Reintentar</button></div>
        }

        @if (activeView == "floor")
        {
            <div class="floor-grid">
                <aside class="table-panel">
                    <div class="section-heading"><div><span class="eyebrow">RESTAURANTE</span><h2>Mesas</h2></div><span class="count-pill">@ActiveTables.Count</span></div>
                    <div class="table-grid">
                        @foreach (var table in ActiveTables.Select(value => value.Name))
                        {
                            var order = FindOrder(table);
                            <button class="table-tile @(selectedTable == table ? "active" : "") @(order is not null ? "occupied" : "")" @onclick="() => SelectTable(table)">
                                <span class="table-status"></span><strong>@table.Replace("Mesa ", "")</strong>
                                <small>@(order is null ? "Disponible" : $"{order.GuestCount} comensales")</small>
                                @if (order is not null) { <span class="table-total">@order.Total.ToString("N2") Bs.</span> }
                            </button>
                        }
                    </div>
                    <div class="legend"><span><i class="free"></i>Disponible</span><span><i class="busy"></i>Ocupada</span></div>
                </aside>

                <section class="menu-panel">
                    <div class="section-heading menu-heading"><div><span class="eyebrow">CATÁLOGO</span><h2>Menú</h2></div><span class="count-pill">@FilteredProducts.Count()</span></div>
                    <label class="search-box"><span>Buscar</span><input @bind="searchText" @bind:event="oninput" placeholder="Plato o código" /></label>
                    <div class="category-list">
                        @foreach (var category in Categories)
                        {
                            <button class="category-chip @(selectedCategory == category ? "selected" : "")" @onclick="() => SelectCategory(category)">@category</button>
                        }
                    </div>
                    <div class="product-list">
                        @foreach (var product in FilteredProducts)
                        {
                            <button class="product-row" @onclick="() => AddDraft(product)" disabled="@CannotAddItems">
                                <span class="product-initial">@ProductInitial(product.Name)</span>
                                <span class="product-copy"><strong>@product.Name</strong><small>@product.CategoryName · @product.Sku</small></span>
                                <span class="product-price">@product.Price.ToString("N2")<small>Bs.</small></span>
                                <span class="add-mark">+</span>
                            </button>
                        }
                        @if (!FilteredProducts.Any())
                        {
                            <div class="empty-menu">@(menu.Count == 0 ? "Agrega productos al catálogo de inventario para armar el menú." : "No hay productos para esta búsqueda.")</div>
                        }
                    </div>
                </section>

                <aside class="order-panel">
                    @{ var currentOrder = FindOrder(selectedTable); }
                    <div class="order-topline"><span class="eyebrow">MESA SELECCIONADA</span><span class="order-number">@(currentOrder is null ? "NUEVA" : $"ORDEN #{currentOrder.Id:0000}")</span></div>
                    <h2>@(string.IsNullOrWhiteSpace(selectedTable) ? "Sin mesas activas" : selectedTable)</h2>
                    <div class="order-meta">
                        <label>Comensales<input type="number" min="1" max="@SelectedTableCapacity" @bind="guestCount" disabled="@(currentOrder is not null || string.IsNullOrWhiteSpace(selectedTable))" /></label>
                        <label>Mesero<input @bind="waiterName" disabled="@(currentOrder is not null)" /></label>
                    </div>
                    @if (currentOrder is not null)
                    {
                        <div class="order-state"><span class="state-dot status-@currentOrder.Status.ToString().ToLowerInvariant()"></span>@StatusLabel(currentOrder.Status)<small>· @currentOrder.CreatedAtUtc.ToLocalTime().ToString("HH:mm")</small></div>
                        @if (!string.IsNullOrWhiteSpace(currentOrder.Notes)) { <p class="order-note">@currentOrder.Notes</p> }
                    }
                    <div class="order-lines">
                        @if (currentOrder is not null)
                        {
                            @foreach (var line in currentOrder.Lines)
                            {
                                <div class="order-line"><span><strong>@line.Quantity.ToString("0.##")×</strong> @line.ProductName</span><strong>@((line.Quantity * line.UnitPrice).ToString("N2"))</strong></div>
                            }
                        }
                        @foreach (var line in draftLines)
                        {
                            <div class="order-line draft-line"><span><strong>@line.Quantity.ToString("0.##")×</strong> @line.Product.Name</span><button title="Quitar" aria-label="Quitar @line.Product.Name" @onclick="() => RemoveDraft(line.Product.Id)">×</button><strong>@((line.Quantity * line.Product.Price).ToString("N2"))</strong></div>
                        }
                        @if (currentOrder is null && draftLines.Count == 0)
                        {
                            <div class="empty-order"><span class="empty-ring">+</span><strong>Empieza la comanda</strong><small>Selecciona productos del menú.</small></div>
                        }
                    </div>
                    @if (currentOrder is null)
                    {
                        <label class="note-field">Nota para cocina<textarea @bind="orderNotes" placeholder="Sin cebolla, alergias..." rows="2"></textarea></label>
                    }
                    <div class="order-total"><span>Total</span><strong>@OrderTotal.ToString("N2") <small>Bs.</small></strong></div>
                    @if (currentOrder is null)
                    {
                        <button class="primary-action" @onclick="CreateOrderAsync" disabled="@(string.IsNullOrWhiteSpace(selectedTable) || draftLines.Count == 0 || isSaving)">@(isSaving ? "Enviando..." : "Enviar comanda a cocina")<span>→</span></button>
                    }
                    else if (currentOrder.Status < RestaurantOrderStatus.Ready)
                    {
                        <button class="primary-action" @onclick="AddLinesAsync" disabled="@(draftLines.Count == 0 || isSaving)">Agregar a comanda<span>+</span></button>
                    }
                    else if (currentOrder.Status == RestaurantOrderStatus.Served)
                    {
                        <button class="close-action" @onclick="() => AdvanceOrderAsync(currentOrder)">Cerrar cuenta · liberar mesa<span>→</span></button>
                    }
                    else
                    {
                        <button class="muted-action" @onclick="ShowKitchen">Ver tablero de cocina<span>→</span></button>
                    }
                </aside>
            </div>
        }
        else if (activeView == "kitchen")
        {
            <section class="kitchen-view">
                <div class="kitchen-heading"><div><span class="eyebrow">PRODUCCIÓN</span><h2>Tablero de cocina</h2></div><span class="kitchen-live"><i></i>@ActiveOrders.Count órdenes activas</span></div>
                <div class="kitchen-columns">
                    @foreach (var status in KitchenStatuses)
                    {
                        var stateOrders = ActiveOrders.Where(order => order.Status == status).OrderBy(order => order.CreatedAtUtc).ToList();
                        <section class="kitchen-column">
                            <div class="column-heading"><h3>@StatusLabel(status)</h3><span>@stateOrders.Count</span></div>
                            @foreach (var order in stateOrders)
                            {
                                <article class="ticket">
                                    <div class="ticket-head"><strong>@order.TableName</strong><span>#@order.Id.ToString("0000")</span></div>
                                    <div class="ticket-sub">@order.GuestCount comensales · @order.WaiterName <time>@order.CreatedAtUtc.ToLocalTime().ToString("HH:mm")</time></div>
                                    <div class="ticket-lines">
                                        @foreach (var line in order.Lines)
                                        {
                                            <div><strong>@line.Quantity.ToString("0.##")×</strong> @line.ProductName</div>
                                            @if (!string.IsNullOrWhiteSpace(line.Notes)) { <small>↳ @line.Notes</small> }
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(order.Notes)) { <div class="ticket-note">@order.Notes</div> }
                                    <button class="ticket-action" @onclick="() => AdvanceOrderAsync(order)">@NextAction(order.Status)<span>→</span></button>
                                </article>
                            }
                            @if (stateOrders.Count == 0) { <div class="column-empty">Sin comandas</div> }
                        </section>
                    }
                </div>
            </section>
        }
        else
        {
            <section class="admin-view">
                <div class="admin-heading"><div><span class="eyebrow">CONFIGURACIÓN</span><h2>Administrar restaurante</h2></div></div>
                <div class="admin-tabs" role="tablist" aria-label="Administración del restaurante">
                    <button class="@(adminSection == "tables" ? "selected" : "")" @onclick="ShowTableAdmin">Mesas</button>
                    <button class="@(adminSection == "menu" ? "selected" : "")" @onclick="ShowMenuAdminAsync">Menú</button>
                </div>

                @if (adminSection == "tables")
                {
                    <section class="admin-section">
                        <div class="section-heading"><div><span class="eyebrow">SALA</span><h2>Mesas</h2></div><span class="count-pill">@tables.Count</span></div>
                        <div class="admin-create-form">
                            <label>Nombre<input @bind="newTableName" placeholder="Mesa 09" maxlength="80" /></label>
                            <label>Capacidad<input type="number" min="1" max="30" @bind="newTableCapacity" /></label>
                            <button class="admin-action" @onclick="CreateTableAsync" disabled="@(string.IsNullOrWhiteSpace(newTableName) || isSaving)">Crear mesa<span>+</span></button>
                        </div>
                        <div class="management-list">
                            @foreach (var table in tables)
                            {
                                <article class="management-row">
                                    <div class="management-copy"><strong>@table.Name</strong><small>@table.Capacity lugares · @(table.IsActive ? "Activa" : "Inactiva")</small></div>
                                    <button class="secondary-action" @onclick="() => EditTable(table)">Editar</button>
                                </article>
                                @if (editingTableId == table.Id)
                                {
                                    <div class="management-editor">
                                        <label>Nombre<input @bind="editTableName" maxlength="80" /></label>
                                        <label>Capacidad<input type="number" min="1" max="30" @bind="editTableCapacity" /></label>
                                        <label class="check-field"><input type="checkbox" @bind="editTableIsActive" /> Activa</label>
                                        <div class="editor-actions"><button class="admin-action" @onclick="() => SaveTableAsync(table.Id)" disabled="@isSaving">Guardar cambios</button><button class="secondary-action" @onclick="CancelEditTable">Cancelar</button></div>
                                    </div>
                                }
                            }
                            @if (tables.Count == 0)
                            {
                                <div class="admin-empty">Todavía no hay mesas configuradas.</div>
                            }
                        </div>
                    </section>
                }
                else
                {
                    <section class="admin-section">
                        <div class="section-heading"><div><span class="eyebrow">CATÁLOGO</span><h2>Productos del menú</h2></div><span class="count-pill">@adminMenuProducts.Count(product => product.IsAvailable)</span></div>
                        <label class="search-box admin-search"><span>Buscar</span><input @bind="adminSearchText" @bind:event="oninput" placeholder="Producto o código" /></label>
                        <div class="management-list menu-management-list">
                            @foreach (var product in FilteredAdminMenuProducts)
                            {
                                <article class="menu-management-row">
                                    <label class="publish-toggle"><input type="checkbox" checked="@product.IsAvailable" @onchange="args => ToggleMenuProductAsync(product, args.Value is bool available && available)" /><span>En menú</span></label>
                                    <div class="management-copy"><strong>@product.Name</strong><small>@product.CategoryName · @product.Sku · Inventario: @product.InventoryPrice.ToString("N2")</small></div>
                                    <label class="menu-price-field">Precio menú<input type="number" min="0" step="0.01" value="@GetMenuPriceDraft(product)" @oninput="args => SetMenuPriceDraft(product.ProductId, args.Value?.ToString())" placeholder="Inventario" /></label>
                                    <button class="secondary-action" @onclick="() => SaveMenuPriceAsync(product)">Guardar</button>
                                </article>
                            }
                            @if (!FilteredAdminMenuProducts.Any())
                            {
                                <div class="admin-empty">No hay productos que coincidan con la búsqueda.</div>
                            }
                        </div>
                    </section>
                }
            </section>
        }
    </main>
</div>

@code {
    private static readonly RestaurantOrderStatus[] KitchenStatuses = [RestaurantOrderStatus.New, RestaurantOrderStatus.Preparing, RestaurantOrderStatus.Ready];
    private List<RestaurantTable> tables = [];
    private List<MenuProduct> menu = [];
    private List<RestaurantOrder> orders = [];
    private List<RestaurantMenuAdminProduct> adminMenuProducts = [];
    private readonly Dictionary<int, string> menuPriceDrafts = [];
    private readonly List<DraftLine> draftLines = [];
    private string selectedTable = "Mesa 01";
    private string adminSection = "tables";
    private string newTableName = string.Empty;
    private int newTableCapacity = 4;
    private int? editingTableId;
    private string editTableName = string.Empty;
    private int editTableCapacity = 4;
    private bool editTableIsActive;
    private string adminSearchText = string.Empty;
    private string selectedCategory = "Todo";
    private string searchText = string.Empty;
    private string waiterName = "Ana";
    private string orderNotes = string.Empty;
    private string activeView = "floor";
    private int guestCount = 2;
    private string? errorMessage;
    private bool isLoading;
    private bool isSaving;

    private IReadOnlyList<RestaurantOrder> ActiveOrders => orders.Where(order => order.Status != RestaurantOrderStatus.Closed).ToList();
    private IReadOnlyList<RestaurantOrder> ReadyOrders => ActiveOrders.Where(order => order.Status == RestaurantOrderStatus.Ready).ToList();
    private IReadOnlyList<RestaurantTable> ActiveTables => tables.Where(table => table.IsActive).ToList();
    private int SelectedTableCapacity => ActiveTables.FirstOrDefault(table => table.Name == selectedTable)?.Capacity ?? 30;
    private IEnumerable<RestaurantMenuAdminProduct> FilteredAdminMenuProducts => adminMenuProducts
        .Where(product => string.IsNullOrWhiteSpace(adminSearchText)
            || product.Name.Contains(adminSearchText, StringComparison.OrdinalIgnoreCase)
            || product.Sku.Contains(adminSearchText, StringComparison.OrdinalIgnoreCase));
    private IEnumerable<string> Categories => new[] { "Todo" }.Concat(menu.Select(item => item.CategoryName).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(value => value));
    private IEnumerable<MenuProduct> FilteredProducts => menu
        .Where(item => selectedCategory == "Todo" || item.CategoryName.Equals(selectedCategory, StringComparison.OrdinalIgnoreCase))
        .Where(item => string.IsNullOrWhiteSpace(searchText)
            || item.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || item.Sku.Contains(searchText, StringComparison.OrdinalIgnoreCase));
    private decimal OrderTotal => (FindOrder(selectedTable)?.Total ?? 0) + draftLines.Sum(line => line.Quantity * line.Product.Price);
    private bool CannotAddItems => FindOrder(selectedTable)?.Status >= RestaurantOrderStatus.Ready;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            tables = await Http.GetFromJsonAsync<List<RestaurantTable>>("api/restaurant-tables") ?? [];
            var activeTables = tables.Where(table => table.IsActive).ToList();
            selectedTable = activeTables.FirstOrDefault(table => table.Name == selectedTable)?.Name
                ?? activeTables.FirstOrDefault()?.Name
                ?? string.Empty;
            menu = await Http.GetFromJsonAsync<List<MenuProduct>>("api/restaurant-orders/menu") ?? [];
            orders = await Http.GetFromJsonAsync<List<RestaurantOrder>>("api/restaurant-orders") ?? [];
        }
        catch (HttpRequestException)
        {
            errorMessage = "No se pudo conectar con Inventory.API. Comprueba que la API esté activa y vuelve a intentar.";
        }
        finally { isLoading = false; }
    }

    private RestaurantOrder? FindOrder(string table) => ActiveOrders.FirstOrDefault(order => order.TableName == table);
    private void ShowFloor() => activeView = "floor";
    private void ShowKitchen() => activeView = "kitchen";
    private void ShowAdmin() { activeView = "admin"; adminSection = "tables"; }
    private void ShowTableAdmin() => adminSection = "tables";
    private async Task ShowMenuAdminAsync()
    {
        adminSection = "menu";
        await LoadAdminMenuAsync();
    }
    private void SelectCategory(string category) => selectedCategory = category;

    private async Task LoadAdminMenuAsync()
    {
        try
        {
            adminMenuProducts = await Http.GetFromJsonAsync<List<RestaurantMenuAdminProduct>>("api/restaurant-menu/products") ?? [];
            menuPriceDrafts.Clear();
            foreach (var product in adminMenuProducts)
                menuPriceDrafts[product.ProductId] = product.MenuPrice?.ToString("0.##") ?? string.Empty;
        }
        catch (HttpRequestException)
        {
            errorMessage = "No se pudo cargar el catálogo de productos.";
        }
    }

    private async Task CreateTableAsync()
    {
        isSaving = true;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/restaurant-tables", new CreateRestaurantTable(newTableName, newTableCapacity));
            if (!response.IsSuccessStatusCode) { errorMessage = "No se pudo crear la mesa. Comprueba que el nombre no esté repetido y la capacidad sea válida."; return; }
            newTableName = string.Empty;
            newTableCapacity = 4;
            await LoadAsync();
        }
        catch (HttpRequestException) { errorMessage = "No se pudo crear la mesa. Comprueba la conexión."; }
        finally { isSaving = false; }
    }

    private void EditTable(RestaurantTable table)
    {
        editingTableId = table.Id;
        editTableName = table.Name;
        editTableCapacity = table.Capacity;
        editTableIsActive = table.IsActive;
    }

    private void CancelEditTable() => editingTableId = null;

    private async Task SaveTableAsync(int id)
    {
        isSaving = true;
        try
        {
            using var response = await Http.PutAsJsonAsync($"api/restaurant-tables/{id}", new UpdateRestaurantTable(editTableName, editTableCapacity, editTableIsActive));
            if (!response.IsSuccessStatusCode) { errorMessage = "No se pudo guardar la mesa. Puede tener una comanda abierta o un nombre duplicado."; return; }
            editingTableId = null;
            await LoadAsync();
        }
        catch (HttpRequestException) { errorMessage = "No se pudo actualizar la mesa. Comprueba la conexión."; }
        finally { isSaving = false; }
    }

    private string GetMenuPriceDraft(RestaurantMenuAdminProduct product) =>
        menuPriceDrafts.GetValueOrDefault(product.ProductId, string.Empty);

    private void SetMenuPriceDraft(int productId, string? value) => menuPriceDrafts[productId] = value ?? string.Empty;

    private async Task ToggleMenuProductAsync(RestaurantMenuAdminProduct product, bool isAvailable) =>
        await SaveMenuProductAsync(product, isAvailable, product.MenuPrice);

    private async Task SaveMenuPriceAsync(RestaurantMenuAdminProduct product)
    {
        var priceText = GetMenuPriceDraft(product);
        decimal? menuPrice = null;
        if (!string.IsNullOrWhiteSpace(priceText))
        {
            if (!decimal.TryParse(priceText, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var parsedPrice) || parsedPrice < 0)
            {
                errorMessage = "Indica un precio válido, igual o mayor que cero.";
                return;
            }
            menuPrice = parsedPrice;
        }

        await SaveMenuProductAsync(product, product.IsAvailable, menuPrice);
    }

    private async Task SaveMenuProductAsync(RestaurantMenuAdminProduct product, bool isAvailable, decimal? menuPrice)
    {
        try
        {
            using var response = await Http.PutAsJsonAsync(
                $"api/restaurant-menu/products/{product.ProductId}",
                new UpdateRestaurantMenuProduct(isAvailable, menuPrice));
            if (!response.IsSuccessStatusCode) { errorMessage = "No se pudo guardar el producto del menú."; return; }
            var index = adminMenuProducts.FindIndex(value => value.ProductId == product.ProductId);
            if (index >= 0) adminMenuProducts[index] = product with { IsAvailable = isAvailable, MenuPrice = menuPrice };
            menuPriceDrafts[product.ProductId] = menuPrice?.ToString("0.##") ?? string.Empty;
            await LoadAsync();
        }
        catch (HttpRequestException) { errorMessage = "No se pudo guardar el producto. Comprueba la conexión."; }
    }

    private void SelectTable(string table)
    {
        selectedTable = table;
        draftLines.Clear();
        orderNotes = string.Empty;
        var capacity = ActiveTables.FirstOrDefault(value => value.Name == table)?.Capacity ?? 2;
        guestCount = FindOrder(table)?.GuestCount ?? Math.Min(2, capacity);
    }

    private void AddDraft(MenuProduct product)
    {
        var line = draftLines.FirstOrDefault(value => value.Product.Id == product.Id);
        if (line is null) draftLines.Add(new DraftLine(product));
        else line.Quantity++;
    }

    private void RemoveDraft(int productId) => draftLines.RemoveAll(line => line.Product.Id == productId);

    private async Task CreateOrderAsync()
    {
        if (draftLines.Count == 0 || FindOrder(selectedTable) is not null) return;
        isSaving = true;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/restaurant-orders", new CreateRestaurantOrder(
                selectedTable, guestCount, waiterName, orderNotes, ToRequests()));
            if (!response.IsSuccessStatusCode) { errorMessage = "No se pudo crear la comanda. Revisa los datos e inténtalo de nuevo."; return; }
            draftLines.Clear();
            orderNotes = string.Empty;
            await LoadAsync();
        }
        catch (HttpRequestException) { errorMessage = "No se pudo enviar la comanda. Comprueba la conexión."; }
        finally { isSaving = false; }
    }

    private async Task AddLinesAsync()
    {
        var order = FindOrder(selectedTable);
        if (order is null || draftLines.Count == 0) return;
        isSaving = true;
        try
        {
            using var response = await Http.PostAsJsonAsync($"api/restaurant-orders/{order.Id}/lines", new AddRestaurantOrderLines(ToRequests()));
            if (!response.IsSuccessStatusCode) { errorMessage = "No se pudieron agregar los productos a la comanda."; return; }
            draftLines.Clear();
            await LoadAsync();
        }
        catch (HttpRequestException) { errorMessage = "No se pudo actualizar la comanda. Comprueba la conexión."; }
        finally { isSaving = false; }
    }

    private async Task AdvanceOrderAsync(RestaurantOrder order)
    {
        var next = (RestaurantOrderStatus)((int)order.Status + 1);
        try
        {
            using var response = await Http.PatchAsJsonAsync($"api/restaurant-orders/{order.Id}/status", new AdvanceRestaurantOrderStatus(next));
            if (!response.IsSuccessStatusCode) { errorMessage = "No se pudo avanzar el estado de la comanda."; return; }
            await LoadAsync();
        }
        catch (HttpRequestException) { errorMessage = "No se pudo actualizar la comanda. Comprueba la conexión."; }
    }

    private List<CreateRestaurantOrderLine> ToRequests() => draftLines
        .Select(line => new CreateRestaurantOrderLine(line.Product.Id, line.Quantity, null))
        .ToList();

    private static string StatusLabel(RestaurantOrderStatus status) => status switch
    {
        RestaurantOrderStatus.New => "Nueva",
        RestaurantOrderStatus.Preparing => "En preparación",
        RestaurantOrderStatus.Ready => "Lista",
        RestaurantOrderStatus.Served => "Servida",
        _ => "Cerrada"
    };

    private static string NextAction(RestaurantOrderStatus status) => status switch
    {
        RestaurantOrderStatus.New => "Empezar preparación",
        RestaurantOrderStatus.Preparing => "Marcar lista",
        RestaurantOrderStatus.Ready => "Marcar servida",
        _ => "Cerrar cuenta"
    };

    private static string ProductInitial(string name) => string.IsNullOrWhiteSpace(name) ? "·" : name[..1].ToUpperInvariant();

    private sealed class DraftLine(MenuProduct product)
    {
        public MenuProduct Product { get; } = product;
        public decimal Quantity { get; set; } = 1;
    }
}
@using Inventory.Core.Classes
@using Inventory.Core.Enums
@using Inventory.RazorLib.Components
@using Inventory.SharedUI.Services
@inject ItemApiService ApiService
@inject CurrencyApiService CurrencyService
@inject CategoryApiService CategoryService
@inject TaxApiService TaxService
@inject CustomerAccountApiService AccountApi
@inject UserStateService UserState
    
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="px-4 py-4" style="background: linear-gradient(135deg, #f8fbff 0%, #eef6ff 100%);">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <div>
                <h3 class="mb-1 text-primary fw-semibold">@(isEditing ? "✏️ Editar producto" : "➕ Agregar producto")</h3>
                <p class="text-muted mb-0">Organiza la información del producto en secciones claras y mantén el inventario más ordenado.</p>
            </div>
            <span class="badge rounded-pill bg-white border text-primary px-3 py-2 shadow-sm">
                @(isEditing ? "Modo edición" : "Nuevo registro")
            </span>
        </div>
    </div>

    <div class="card-body p-4">
        <EditForm Model="@newItem" OnSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            @if (!string.IsNullOrEmpty(feedbackMessage))
            {
                <div class="alert @feedbackClass mt-3" role="alert">
                    @feedbackMessage
                </div>
            }

            <div class="row g-4">
                <div class="col-12">
                    <div class="section-card rounded-3 border p-3">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="badge rounded-pill bg-primary-subtle text-primary">1</span>
                            <h6 class="mb-0 fw-semibold text-secondary">Información básica</h6>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Nombre</label>
                                <input class="@GetTextInputCss(string.IsNullOrWhiteSpace(newItem.Name))" @bind="newItem.Name" placeholder="Nombre del producto" />
                                <div class="@GetFeedbackCss(string.IsNullOrWhiteSpace(newItem.Name))">El nombre es obligatorio.</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">SKU</label>
                                <div class="input-group">
                                    <input class="@GetTextInputCss(!autoGenerateSku && string.IsNullOrWhiteSpace(newItem.SKU))" @bind="newItem.SKU" placeholder="e.g., SKU000001" disabled="@autoGenerateSku" />
                                    <button class="btn btn-outline-secondary" type="button" @onclick="GenerateSku">Generar</button>
                                </div>
                                <div class="@GetFeedbackCss(!autoGenerateSku && string.IsNullOrWhiteSpace(newItem.SKU))">El SKU es obligatorio cuando no se genera automáticamente.</div>
                                <div class="form-text mt-1">
                                    <input class="form-check-input me-1" type="checkbox" id="autoSku" @bind="autoGenerateSku" />
                                    <label class="form-check-label" for="autoSku">Generar SKU automáticamente</label>
                                </div>
                                @if (autoGenerateSku)
                                {
                                    <div class="form-text">Vista previa: <strong>@PreviewSku</strong></div>
                                }
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Código de barras</label>
                                <input class="form-control" @bind="newItem.Barcode" placeholder="Escanea o escribe el código" />
                                <div class="form-text">Se guarda con el producto para escanearlo en notas.</div>
                            </div>
                            <div class="col-md-12">
                                <BarcodeScanner OnScanned="HandleBarcodeScanned" />
                            </div>
                            @if (!autoGenerateSku)
                            {
                                <div class="col-md-2">
                                    <label class="form-label">Prefijo</label>
                                    <input class="form-control" @bind="skuPrefix" placeholder="SKU" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Dígitos</label>
                                    <input type="number" class="form-control" @bind="skuDigits" min="1" max="12" />
                                </div>
                            }
                            <div class="col-md-3">
                                <label class="form-label">Categoría</label>
                                <select class="@GetSelectCss(newItem.CategoryId == 0)" @bind="newItem.CategoryId">
                                    @if (!categories.Any())
                                    {
                                        <option value="0">Cargando categorías...</option>
                                    }
                                    else
                                    {
                                        <option value="0">-- Selecciona una categoría --</option>
                                        @foreach (var category in categories)
                                        {
                                            <option value="@category.Id">@category.Name</option>
                                        }
                                    }
                                </select>
                                <div class="@GetFeedbackCss(newItem.CategoryId == 0)">Selecciona una categoría.</div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Moneda</label>
                                <select class="@GetSelectCss(newItem.CurrencyId == 0)" @bind="newItem.CurrencyId">
                                    @if (!currencies.Any())
                                    {
                                        <option disabled>Cargando monedas...</option>
                                    }
                                    else
                                    {
                                        <option value="0">-- Selecciona una moneda --</option>
                                        @foreach (var currency in currencies)
                                        {
                                            <option value="@currency.Id">@currency.Code - @currency.Name</option>
                                        }
                                    }
                                </select>
                                <div class="@GetFeedbackCss(newItem.CurrencyId == 0)">Selecciona una moneda.</div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Unidad</label>
                                <select class="form-select" @bind="newItem.Unit">
                                    @foreach (var unit in Enum.GetValues<UnitType>())
                                    {
                                        <option value="@unit">@unit</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="@GetSectionCss(false)">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="badge rounded-pill bg-success-subtle text-success">2</span>
                            <h6 class="mb-0 fw-semibold text-secondary">Precios e impuestos</h6>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Costo</label>
                                <div class="input-group">
                                    <span class="input-group-text">@CurrencySymbol</span>
                                    <input type="number" step="0.01" min="0" class="@GetTextInputCss(newItem.Cost < 0)"
                                           @bind="newItem.Cost" @bind:after="RecalculatePrice" placeholder="0.00" />
                                </div>
                                <div class="@GetFeedbackCss(newItem.Cost < 0)">El costo no puede ser negativo.</div>
                                <div class="form-text">Costo de adquisición del producto.</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Margen de ganancia</label>
                                <div class="input-group">
                                    <input type="number" step="0.01" min="0" class="@GetTextInputCss(newItem.ProfitMargin < 0)"
                                           @bind="newItem.ProfitMargin" @bind:after="RecalculatePrice" placeholder="0" />
                                    <span class="input-group-text">%</span>
                                </div>
                                <div class="@GetFeedbackCss(newItem.ProfitMargin < 0)">El margen no puede ser negativo.</div>
                                <div class="form-text">El precio de venta se calcula con este margen.</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Precio de venta</label>
                                <div class="input-group">
                                    <span class="input-group-text">@CurrencySymbol</span>
                                    <input type="number" step="0.01" class="@GetTextInputCss(newItem.Price <= 0) fw-bold"
                                           @bind="newItem.Price" readonly="@(newItem.Cost > 0)" />
                                </div>
                                <div class="@GetFeedbackCss(newItem.Price <= 0)">El precio debe ser mayor que cero.</div>
                                @if (newItem.Cost > 0)
                                {
                                    <div class="form-text text-success">
                                        Ganancia: <strong>@CurrencySymbol@newItem.ProfitAmount.ToString("N2")</strong> por unidad (calculado)
                                    </div>
                                }
                                else
                                {
                                    <div class="form-text">Sin costo: ingresa el precio manualmente.</div>
                                }
                            </div>
                            <div class="col-12">
                                <h6 class="mt-2 mb-3">📌 Precios adicionales</h6>
                                <div class="row g-2 align-items-center mb-2">
                                    <div class="col-sm-4">
                                        <input class="form-control form-control-sm" placeholder="Etiqueta (Retail, Mayorista)" @bind="newPriceLabel" />
                                    </div>
                                    <div class="col-sm-3">
                                        <input type="number" step="0.01" class="form-control form-control-sm" placeholder="Monto" @bind="newPriceAmount" />
                                    </div>
                                    <div class="col-sm-3">
                                        <select class="form-select form-select-sm" @bind="newPriceCurrencyId">
                                            @if (currencies.Any())
                                            {
                                                @foreach (var c in currencies)
                                                {
                                                    <option value="@c.Id">@c.Code</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-sm-2">
                                        <button type="button" class="btn btn-outline-secondary btn-sm w-100" @onclick="AddPriceVariant">➕ Añadir</button>
                                    </div>
                                </div>

                                @if (newItem.PriceVariants != null && newItem.PriceVariants.Any())
                                {
                                    <div class="mb-2">
                                        @foreach (var p in newItem.PriceVariants)
                                        {
                                            <span class="badge bg-light text-dark border me-2 p-2">
                                                <strong>@p.Label:</strong> @p.Amount @(" " + (currencies.FirstOrDefault(c => c.Id == p.CurrencyId)?.Code ?? string.Empty))
                                                <button type="button" class="btn-close ms-2" style="font-size: 0.6rem;" @onclick="() => RemovePriceVariant(p)"></button>
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Aplicar impuestos</label>
                                @if (!taxes.Any())
                                {
                                    <div class="form-text text-muted">No hay impuestos configurados aún.</div>
                                }
                                else
                                {
                                    <div class="rounded p-2" style="max-height: 220px; overflow-y: auto;">
                                        @foreach (var tax in taxes)
                                        {
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="tax-@tax.Id"
                                                       checked="@selectedTaxIds.Contains(tax.Id)"
                                                       @onchange="e => ToggleTaxSelection(e, tax.Id)" />
                                                <label class="form-check-label" for="tax-@tax.Id">
                                                    @tax.Name (@tax.Rate.ToString("N2")%)
                                                </label>
                                            </div>
                                        }
                                    </div>
                                    <div class="form-text mt-2">Los impuestos son opcionales y se aplican desde la lista de impuestos.</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="@GetSectionCss(StockSectionInvalid)">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="badge rounded-pill bg-warning-subtle text-warning">3</span>
                            <h6 class="mb-0 fw-semibold text-secondary">Existencias por depósito / tienda</h6>
                        </div>
                        @if (!locations.Any())
                        {
                            <div class="alert alert-warning py-2 mb-0">
                                No hay depósitos ni tiendas registrados.
                                <a href="/account-locations">Regístralos aquí</a> para poder cargar existencias.
                            </div>
                        }
                        else
                        {
                            <div class="row g-2 mb-2">
                                @foreach (var location in locations)
                                {
                                    <div class="col-md-4">
                                        <label class="form-label">
                                            @location.Name
                                            <small class="text-muted">(@(location.Type == LocationType.Warehouse ? "Depósito" : "Tienda"))</small>
                                        </label>
                                        <input type="number" step="0.1" min="0" class="form-control"
                                               value="@GetStockInput(location.Id)"
                                               @onchange="e => SetStockInput(location.Id, e.Value?.ToString())" />
                                    </div>
                                }
                            </div>
                            @if (StockSectionInvalid)
                            {
                                <div class="invalid-feedback d-block">Ingresa existencias en al menos una ubicación.</div>
                            }
                            <div class="form-text mb-0">
                                Total: <strong>@StockInputTotal</strong> @newItem.Unit.
                                @(isEditing
                                    ? "Al guardar se ajustan las existencias de las ubicaciones que hayas cambiado."
                                    : "Estas son las existencias iniciales del artículo.")
                            </div>
                        }
                    </div>
                </div>

                <div class="col-12">
                    <div class="section-card rounded-3 border p-3">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="badge rounded-pill bg-secondary-subtle text-secondary">4</span>
                            <h6 class="mb-0 fw-semibold text-secondary">Atributos personalizados</h6>
                        </div>
                        <div class="row g-2 align-items-center mb-3">
                            <div class="col-sm-4">
                                <input class="form-control form-control-sm" @bind="newAttrKey" placeholder="Propiedad (ej. Tamaño, Color)" />
                            </div>
                            <div class="col-sm-5">
                                <input class="form-control form-control-sm" @bind="newAttrValue" placeholder="Valor (ej. 5W-30, Azul)" />
                            </div>
                            <div class="col-sm-3">
                                <button type="button" class="btn btn-outline-secondary btn-sm w-100" @onclick="AddAttribute">➕ Añadir</button>
                            </div>
                        </div>

                        @if (newItem.Attributes.Any())
                        {
                            <div class="mb-0">
                                @foreach (var attr in newItem.Attributes)
                                {
                                    <span class="badge bg-light text-dark border me-2 p-2">
                                        <strong>@attr.Name:</strong> @attr.Value
                                        <button type="button" class="btn-close ms-2" style="font-size: 0.6rem;" @onclick="() => newItem.Attributes.Remove(attr)"></button>
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mt-4">
                <div class="text-muted small">Completa los campos obligatorios para guardar el producto.</div>
                <div class="d-grid gap-2 d-md-flex">
                    <button type="submit" class="btn btn-primary">@(isEditing ? "💾 Guardar cambios" : "💾 Guardar producto")</button>
                    <button type="button" class="btn btn-secondary" @onclick="() => OnCancel.InvokeAsync()">✖️ Cancelar</button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

<style>
    .section-card {
        background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    }
</style>

@code {
    [Parameter] public EventCallback OnItemSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public ItemUniversal? ItemToEdit { get; set; }

    private bool isEditing;
    private ItemUniversal newItem = new();

    private static string GetTextInputCss(bool invalid) => invalid ? "form-control is-invalid" : "form-control";
    private static string GetSelectCss(bool invalid) => invalid ? "form-select is-invalid" : "form-select";
    private static string GetFeedbackCss(bool invalid) => invalid ? "invalid-feedback d-block" : "invalid-feedback";
    private List<ItemUniversal> existingItems = new();
    private List<Currency> currencies = new();
    private List<Category> categories = new();
    private List<Tax> taxes = new();
    private List<int> selectedTaxIds = new();
    private string newAttrKey = "";
    private string newAttrValue = "";
    private string newPriceLabel = string.Empty;
    private decimal newPriceAmount = 0m;
    private bool showValidationErrors;
    private int newPriceCurrencyId = 0;
    private bool autoGenerateSku = true;
    private string skuPrefix = string.Empty;
    private int skuDigits = 9;
    private string feedbackMessage = string.Empty;
    private string feedbackClass = string.Empty;

    private List<AccountLocation> locations = new();

    // Cantidad escrita por ubicación, y la que traía al abrir el formulario,
    // para saber qué ubicaciones cambiaron de verdad al editar.
    private Dictionary<int, double> stockInputs = new();
    private Dictionary<int, double> originalStock = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrencies();
        await LoadCategories();
        await LoadTaxes();
        await LoadExistingItems();
        await LoadLocations();

        if (ItemToEdit != null)
        {
            LoadItemForEditing(ItemToEdit);
        }
    }

    /// <summary>Depósitos y tiendas de la cuenta del usuario conectado.</summary>
    private async Task LoadLocations()
    {
        var currentUser = await UserState.GetCurrentUserAsync();
        if (currentUser == null) return;

        locations = await AccountApi.GetLocationsAsync(currentUser.AccountId);
    }

    private double GetStockInput(int locationId) =>
        stockInputs.TryGetValue(locationId, out var value) ? value : 0;

    private void SetStockInput(int locationId, string? raw)
    {
        var parsed = double.TryParse(raw, out var value) ? value : 0;
        stockInputs[locationId] = parsed < 0 ? 0 : parsed;
    }

    private double StockInputTotal =>
        Math.Round(locations.Sum(l => GetStockInput(l.Id)), 2);

    private void LoadItemForEditing(ItemUniversal source)
    {
        isEditing = true;
        autoGenerateSku = false;

        // Trabajamos sobre una copia para no mutar el item de la lista si se cancela.
        newItem = new ItemUniversal
        {
            Id = source.Id,
            SKU = source.SKU,
            Barcode = source.Barcode,
            Name = source.Name,
            Cost = source.Cost,
            ProfitMargin = source.ProfitMargin,
            Price = source.Price,
            TaxRate = source.TaxRate,
            CurrencyId = source.CurrencyId,
            CategoryId = source.CategoryId,
            Stock = source.Stock,
            Unit = source.Unit,
            Attributes = source.Attributes?.Select(a => new Inventory.Core.Classes.Attribute(a.Name, a.Value)).ToList()
                         ?? new List<Inventory.Core.Classes.Attribute>(),
            PriceVariants = source.PriceVariants?.Select(p => new Inventory.Core.Classes.PriceVariant
            {
                Label = p.Label,
                Amount = p.Amount,
                CurrencyId = p.CurrencyId
            }).ToList() ?? new List<Inventory.Core.Classes.PriceVariant>()
        };

        selectedTaxIds = source.Taxes?.Select(t => t.Id).ToList() ?? new List<int>();

        // Existencias actuales por ubicación, para poder detectar los cambios al guardar.
        stockInputs = locations.ToDictionary(l => l.Id, l => source.StockAt(l.Id));
        originalStock = new Dictionary<int, double>(stockInputs);
    }

    private async Task LoadCurrencies()
    {
        currencies = await CurrencyService.GetCurrenciesAsync();
        if (currencies.Any() && newItem.CurrencyId == 0)
        {
            newItem.CurrencyId = currencies.First().Id;
            newPriceCurrencyId = newItem.CurrencyId;
        }
    }

    private async Task LoadCategories()
    {
        categories = await CategoryService.GetCategoriesAsync();
        if (categories.Any() && newItem.CategoryId == 0)
        {
            newItem.CategoryId = categories.First().Id;
        }

        if (taxes.Any() && !selectedTaxIds.Any())
        {
            selectedTaxIds.Clear();
        }
    }

    private async Task LoadTaxes()
    {
        taxes = await TaxService.GetTaxesAsync();
    }

    private async Task LoadExistingItems()
    {
        existingItems = await ApiService.GetItemsAsync();
    }

    private string CurrencySymbol =>
        currencies.FirstOrDefault(c => c.Id == newItem.CurrencyId)?.Symbol ?? string.Empty;

    // Precio de venta = Costo x (1 + Margen/100). Solo se autocalcula cuando hay un
    // costo definido; si el costo es 0 el usuario ingresa el precio manualmente.
    private void RecalculatePrice()
    {
        if (newItem.Cost > 0)
        {
            newItem.Price = Math.Round(newItem.Cost * (1 + newItem.ProfitMargin / 100m), 2);
        }
    }

    private bool StockSectionInvalid => showValidationErrors && !isEditing && StockInputTotal <= 0;
    private static string GetSectionCss(bool invalid) => invalid ? "section-card rounded-3 border border-danger p-3" : "section-card rounded-3 border p-3";

    private string PreviewSku => GenerateFormattedSku(GetNextSkuNumber());

    private void GenerateSku()
    {
        newItem.SKU = PreviewSku;
    }

    private async Task HandleBarcodeScanned(string code)
    {
        // El código escaneado es el código de barras físico del producto,
        // no el SKU (que se autogenera de forma interna).
        newItem.Barcode = code;
        await Task.CompletedTask;
    }

    private int GetNextSkuNumber()
    {
        var prefix = skuPrefix ?? string.Empty;

        var candidateNumbers = existingItems
            .Select(item => item.SKU ?? string.Empty)
            .Select(sku =>
            {
                if (!string.IsNullOrEmpty(prefix) && sku.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                {
                    sku = sku[prefix.Length..];
                }

                return int.TryParse(sku, out var numeric) ? numeric : 0;
            })
            .Where(value => value >= 0);

        return candidateNumbers.Any() ? candidateNumbers.Max() + 1 : 1;
    }

    private string GenerateFormattedSku(int number)
    {
        var digits = skuDigits < 1 ? 1 : skuDigits;
        return (skuPrefix ?? string.Empty) + number.ToString($"D{digits}");
    }

    private void AddAttribute()
    {
        if (!string.IsNullOrWhiteSpace(newAttrKey) && !string.IsNullOrWhiteSpace(newAttrValue))
        {
            newItem.AddAttribute(newAttrKey.Trim(), newAttrValue.Trim());
            newAttrKey = "";
            newAttrValue = "";
        }
    }

    private void AddPriceVariant()
    {
        if (string.IsNullOrWhiteSpace(newPriceLabel) || newPriceAmount <= 0 || newPriceCurrencyId == 0)
            return;

        newItem.PriceVariants.Add(new Inventory.Core.Classes.PriceVariant
        {
            Label = newPriceLabel.Trim(),
            Amount = newPriceAmount,
            CurrencyId = newPriceCurrencyId
        });

        newPriceLabel = string.Empty;
        newPriceAmount = 0m;
        newPriceCurrencyId = newItem.CurrencyId != 0 ? newItem.CurrencyId : 0;
    }

    private void RemovePriceVariant(Inventory.Core.Classes.PriceVariant p)
    {
        newItem.PriceVariants.Remove(p);
    }

    private void ToggleTaxSelection(ChangeEventArgs e, int taxId)
    {
        if (e.Value is bool isChecked)
        {
            if (isChecked)
            {
                if (!selectedTaxIds.Contains(taxId))
                {
                    selectedTaxIds.Add(taxId);
                }
            }
            else
            {
                selectedTaxIds.Remove(taxId);
            }
        }
    }

    private async Task HandleSubmit()
    {
        showValidationErrors = true;
        feedbackMessage = string.Empty;
        feedbackClass = string.Empty;

        if (autoGenerateSku && string.IsNullOrWhiteSpace(newItem.SKU))
        {
            newItem.SKU = PreviewSku;
        }

        // Aseguramos que el precio quede alineado con costo + margen antes de enviar.
        RecalculatePrice();

        var totalStock = isEditing ? newItem.Stock : StockInputTotal;
        var stockInvalid = isEditing ? newItem.Stock < 0 : totalStock <= 0;

        if (string.IsNullOrWhiteSpace(newItem.SKU)
            || string.IsNullOrWhiteSpace(newItem.Name)
            || newItem.Price <= 0
            || newItem.Cost < 0
            || newItem.ProfitMargin < 0
            || stockInvalid
            || newItem.CurrencyId == 0
            || newItem.CategoryId == 0)
        {
            feedbackMessage = "Por favor completa todos los campos obligatorios y usa valores válidos.";
            feedbackClass = "alert alert-warning";
            return;
        }

        newItem.Taxes = taxes.Where(t => selectedTaxIds.Contains(t.Id)).ToList();

        // Al crear, las existencias iniciales viajan con el artículo. Al editar se
        // aplican después, porque el PUT del artículo no toca las existencias.
        newItem.StockByLocation = isEditing
            ? new List<ItemStock>()
            : locations
                .Where(l => GetStockInput(l.Id) > 0)
                .Select(l => new ItemStock { LocationId = l.Id, Quantity = GetStockInput(l.Id) })
                .ToList();

        newItem.Stock = totalStock;

        var success = isEditing
            ? await ApiService.UpdateItemAsync(newItem)
            : await ApiService.SaveItemAsync(newItem);

        if (!success)
        {
            feedbackMessage = "No se pudo guardar el artículo. Verifica que el SKU no esté duplicado y que la API esté disponible.";
            feedbackClass = "alert alert-danger";
            return;
        }

        var stockError = isEditing ? await ApplyStockChangesAsync() : null;

        feedbackMessage = stockError == null
            ? (isEditing ? "Cambios guardados correctamente." : "Artículo guardado correctamente.")
            : $"El artículo se guardó, pero las existencias no: {stockError}";
        feedbackClass = stockError == null ? "alert alert-success" : "alert alert-warning";

        if (!isEditing)
        {
            newItem = new();
            selectedTaxIds.Clear();
            stockInputs.Clear();
        }

        await OnItemSaved.InvokeAsync();
    }

    /// <summary>
    /// Fija las existencias de las ubicaciones cuya cantidad cambió en el formulario.
    /// Devuelve el primer error encontrado, o null si todo se aplicó.
    /// </summary>
    private async Task<string?> ApplyStockChangesAsync()
    {
        foreach (var location in locations)
        {
            var updated = GetStockInput(location.Id);
            var previous = originalStock.TryGetValue(location.Id, out var value) ? value : 0;
            if (Math.Abs(updated - previous) < 0.0001) continue;

            var (ok, error) = await ApiService.SetStockAtLocationAsync(
                newItem.SKU, location.Id, updated, "Ajuste desde la ficha del artículo");

            if (!ok) return error;
            originalStock[location.Id] = updated;
        }

        return null;
    }
}
@using Inventory.Core.Classes
@using Inventory.Core.Enums
@using Inventory.RazorLib.Components
@using Inventory.RazorLib.Services
@inject ItemApiService ApiService
@inject CurrencyApiService CurrencyService
@inject CategoryApiService CategoryService
@inject TaxApiService TaxService
    
<div class="card p-4 shadow-sm mb-4">
    <h3 class="card-title text-primary">@(isEditing ? "✏️ Editar producto" : "📦 Register New Item")</h3>
    <hr />

    <EditForm Model="@newItem" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        @if (!string.IsNullOrEmpty(feedbackMessage))
        {
            <div class="alert @feedbackClass mt-3" role="alert">
                @feedbackMessage
            </div>
        }

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Name</label>
                <input class="form-control" @bind="newItem.Name" placeholder="Product name" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">SKU</label>
                <div class="input-group">
                    <input class="form-control" @bind="newItem.SKU" placeholder="e.g., SKU000001" disabled="@autoGenerateSku" required />
                    <button class="btn btn-outline-secondary" type="button" @onclick="GenerateSku">Generate</button>
                </div>
                <div class="form-text mt-1">
                    <input class="form-check-input me-1" type="checkbox" id="autoSku" @bind="autoGenerateSku" />
                    <label class="form-check-label" for="autoSku">Auto-generate SKU</label>
                </div>
                @if (autoGenerateSku)
                {
                    <div class="form-text">Preview: <strong>@PreviewSku</strong></div>
                }
            </div>
            <div class="col-md-4">
                <label class="form-label">Código de barras</label>
                <input class="form-control" @bind="newItem.Barcode" placeholder="Escanea o escribe el código" />
                <div class="form-text">Se guarda con el producto para escanearlo en notas.</div>
            </div>
            <div class="col-md-12">
                <BarcodeScanner OnScanned="HandleBarcodeScanned" />
            </div>
            @if (!autoGenerateSku)
            {
                <div class="col-md-2">
                    <label class="form-label">Prefix</label>
                    <input class="form-control" @bind="skuPrefix" placeholder="SKU" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Digits</label>
                    <input type="number" class="form-control" @bind="skuDigits" min="1" max="12" />
                </div>
            }
            <div class="col-md-3">
                <label class="form-label">Category</label>
                <select class="form-select" @bind="newItem.CategoryId">
                    @if (!categories.Any())
                    {
                        <option value="0">Loading categories...</option>
                    }
                    else
                    {
                        <option value="0">-- Select Category --</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Currency</label>
                <select class="form-select" @bind="newItem.CurrencyId">
                    @if (!currencies.Any())
                    {
                        <option disabled>Loading currencies...</option>
                    }
                    else
                    {
                        <option value="0">-- Select Currency --</option>
                        @foreach (var currency in currencies)
                        {
                            <option value="@currency.Id">@currency.Code - @currency.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Unit Type</label>
                <select class="form-select" @bind="newItem.Unit">
                    @foreach (var unit in Enum.GetValues<UnitType>())
                    {
                        <option value="@unit">@unit</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Price</label>
                <input type="number" step="0.01" class="form-control" @bind="newItem.Price" required />
            </div>
            <div class="col-12">
                <h6 class="mt-3">📌 Precios adicionales</h6>
                <div class="row g-2 align-items-center mb-2">
                    <div class="col-sm-4">
                        <input class="form-control form-control-sm" placeholder="Label (e.g., Retail, Wholesale)" @bind="newPriceLabel" />
                    </div>
                    <div class="col-sm-3">
                        <input type="number" step="0.01" class="form-control form-control-sm" placeholder="Amount" @bind="newPriceAmount" />
                    </div>
                    <div class="col-sm-3">
                        <select class="form-select form-select-sm" @bind="newPriceCurrencyId">
                            @if (currencies.Any())
                            {
                                @foreach (var c in currencies)
                                {
                                    <option value="@c.Id">@c.Code</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-sm-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100" @onclick="AddPriceVariant">➕ Add Price</button>
                    </div>
                </div>

                @if (newItem.PriceVariants != null && newItem.PriceVariants.Any())
                {
                    <div class="mb-2">
                        @foreach (var p in newItem.PriceVariants)
                        {
                            <span class="badge bg-light text-dark border me-2 p-2">
                                <strong>@p.Label:</strong> @p.Amount @(" " + (currencies.FirstOrDefault(c => c.Id == p.CurrencyId)?.Code ?? string.Empty))
                                <button type="button" class="btn-close ms-2" style="font-size: 0.6rem;" @onclick="() => RemovePriceVariant(p)"></button>
                            </span>
                        }
                    </div>
                }
            </div>
            <div class="col-md-4">
                <label class="form-label">Apply Taxes</label>
                @if (!taxes.Any())
                {
                    <div class="form-text text-muted">No taxes configured yet. Add taxes in the Taxes module.</div>
                }
                else
                {
                    <div class="border rounded p-2" style="max-height: 220px; overflow-y: auto;">
                        @foreach (var tax in taxes)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="tax-@tax.Id"
                                       checked="@selectedTaxIds.Contains(tax.Id)"
                                       @onchange="e => ToggleTaxSelection(e, tax.Id)" />
                                <label class="form-check-label" for="tax-@tax.Id">
                                    @tax.Name (@tax.Rate.ToString("N2")%)
                                </label>
                            </div>
                        }
                    </div>
                    <div class="form-text mt-2">Los impuestos se aplican desde la lista de impuestos; no es necesario ingresar una tasa manual.</div>
                }
            </div>
            <div class="col-md-4">
                <label class="form-label">Initial Stock</label>
                <input type="number" step="0.1" class="form-control" @bind="newItem.Stock" required />
            </div>
        </div>

        <h5 class="mt-4 text-secondary">⚙️ Custom Attributes (Specifications)</h5>
        <div class="row g-2 align-items-center mb-3">
            <div class="col-sm-4">
                <input class="form-control form-control-sm" @bind="newAttrKey" placeholder="Property (e.g., Viscosity, Size)" />
            </div>
            <div class="col-sm-5">
                <input class="form-control form-control-sm" @bind="newAttrValue" placeholder="Value (e.g., 5W-30, 2 inches)" />
            </div>
            <div class="col-sm-3">
                <button type="button" class="btn btn-outline-secondary btn-sm w-100" @onclick="AddAttribute">➕ Add Attr</button>
            </div>
        </div>

        @if (newItem.Attributes.Any())
        {
            <div class="mb-3">
                @foreach (var attr in newItem.Attributes)
                {
                    <span class="badge bg-light text-dark border me-2 p-2">
                        <strong>@attr.Name:</strong> @attr.Value
                        <button type="button" class="btn-close ms-2" style="font-size: 0.6rem;" @onclick="() => newItem.Attributes.Remove(attr)"></button>
                    </span>
                }
            </div>
        }

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary mt-2 w-100">@(isEditing ? "💾 Guardar cambios" : "💾 Save Item to Inventory")</button>
            <button type="button" class="btn btn-secondary mt-1 w-100" @onclick="() => OnCancel.InvokeAsync()">✖️ Cancelar</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public EventCallback OnItemSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public ItemUniversal? ItemToEdit { get; set; }

    private bool isEditing;
private ItemUniversal newItem = new();
    private List<ItemUniversal> existingItems = new();
    private List<Currency> currencies = new();
    private List<Category> categories = new();
    private List<Tax> taxes = new();
    private List<int> selectedTaxIds = new();
    private string newAttrKey = "";
    private string newAttrValue = "";
    private string newPriceLabel = string.Empty;
    private decimal newPriceAmount = 0m;
    private int newPriceCurrencyId = 0;
    private bool autoGenerateSku = true;
    private string skuPrefix = string.Empty;
    private int skuDigits = 9;
    private string feedbackMessage = string.Empty;
    private string feedbackClass = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrencies();
        await LoadCategories();
        await LoadTaxes();
        await LoadExistingItems();

        if (ItemToEdit != null)
        {
            LoadItemForEditing(ItemToEdit);
        }
    }

    private void LoadItemForEditing(ItemUniversal source)
    {
        isEditing = true;
        autoGenerateSku = false;

        // Trabajamos sobre una copia para no mutar el item de la lista si se cancela.
        newItem = new ItemUniversal
        {
            Id = source.Id,
            SKU = source.SKU,
            Barcode = source.Barcode,
            Name = source.Name,
            Price = source.Price,
            TaxRate = source.TaxRate,
            CurrencyId = source.CurrencyId,
            CategoryId = source.CategoryId,
            Stock = source.Stock,
            Unit = source.Unit,
            Attributes = source.Attributes?.Select(a => new Inventory.Core.Classes.Attribute(a.Name, a.Value)).ToList()
                         ?? new List<Inventory.Core.Classes.Attribute>(),
            PriceVariants = source.PriceVariants?.Select(p => new Inventory.Core.Classes.PriceVariant
            {
                Label = p.Label,
                Amount = p.Amount,
                CurrencyId = p.CurrencyId
            }).ToList() ?? new List<Inventory.Core.Classes.PriceVariant>()
        };

        selectedTaxIds = source.Taxes?.Select(t => t.Id).ToList() ?? new List<int>();
    }

    private async Task LoadCurrencies()
    {
        currencies = await CurrencyService.GetCurrenciesAsync();
        if (currencies.Any() && newItem.CurrencyId == 0)
        {
            newItem.CurrencyId = currencies.First().Id;
            newPriceCurrencyId = newItem.CurrencyId;
        }
    }

    private async Task LoadCategories()
    {
        categories = await CategoryService.GetCategoriesAsync();
        if (categories.Any() && newItem.CategoryId == 0)
        {
            newItem.CategoryId = categories.First().Id;
        }

        if (taxes.Any() && !selectedTaxIds.Any())
        {
            selectedTaxIds.Clear();
        }
    }

    private async Task LoadTaxes()
    {
        taxes = await TaxService.GetTaxesAsync();
    }

    private async Task LoadExistingItems()
    {
        existingItems = await ApiService.GetItemsAsync();
    }

    private string PreviewSku => GenerateFormattedSku(GetNextSkuNumber());

    private void GenerateSku()
    {
        newItem.SKU = PreviewSku;
    }

    private async Task HandleBarcodeScanned(string code)
    {
        // El código escaneado es el código de barras físico del producto,
        // no el SKU (que se autogenera de forma interna).
        newItem.Barcode = code;
        await Task.CompletedTask;
    }

    private int GetNextSkuNumber()
    {
        var prefix = skuPrefix ?? string.Empty;

        var candidateNumbers = existingItems
            .Select(item => item.SKU ?? string.Empty)
            .Select(sku =>
            {
                if (!string.IsNullOrEmpty(prefix) && sku.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                {
                    sku = sku[prefix.Length..];
                }

                return int.TryParse(sku, out var numeric) ? numeric : 0;
            })
            .Where(value => value >= 0);

        return candidateNumbers.Any() ? candidateNumbers.Max() + 1 : 1;
    }

    private string GenerateFormattedSku(int number)
    {
        var digits = skuDigits < 1 ? 1 : skuDigits;
        return (skuPrefix ?? string.Empty) + number.ToString($"D{digits}");
    }

    private void AddAttribute()
    {
        if (!string.IsNullOrWhiteSpace(newAttrKey) && !string.IsNullOrWhiteSpace(newAttrValue))
        {
            newItem.AddAttribute(newAttrKey.Trim(), newAttrValue.Trim());
            newAttrKey = "";
            newAttrValue = "";
        }
    }

    private void AddPriceVariant()
    {
        if (string.IsNullOrWhiteSpace(newPriceLabel) || newPriceAmount <= 0 || newPriceCurrencyId == 0)
            return;

        newItem.PriceVariants.Add(new Inventory.Core.Classes.PriceVariant
        {
            Label = newPriceLabel.Trim(),
            Amount = newPriceAmount,
            CurrencyId = newPriceCurrencyId
        });

        newPriceLabel = string.Empty;
        newPriceAmount = 0m;
        newPriceCurrencyId = newItem.CurrencyId != 0 ? newItem.CurrencyId : 0;
    }

    private void RemovePriceVariant(Inventory.Core.Classes.PriceVariant p)
    {
        newItem.PriceVariants.Remove(p);
    }

    private void ToggleTaxSelection(ChangeEventArgs e, int taxId)
    {
        if (e.Value is bool isChecked)
        {
            if (isChecked)
            {
                if (!selectedTaxIds.Contains(taxId))
                {
                    selectedTaxIds.Add(taxId);
                }
            }
            else
            {
                selectedTaxIds.Remove(taxId);
            }
        }
    }

    private async Task HandleSubmit()
    {
        feedbackMessage = string.Empty;
        feedbackClass = string.Empty;

        if (autoGenerateSku && string.IsNullOrWhiteSpace(newItem.SKU))
        {
            newItem.SKU = PreviewSku;
        }

        // Al editar permitimos stock 0 (un producto existente puede quedar sin existencias).
        var stockInvalid = isEditing ? newItem.Stock < 0 : newItem.Stock <= 0;

        if (string.IsNullOrWhiteSpace(newItem.SKU)
            || string.IsNullOrWhiteSpace(newItem.Name)
            || newItem.Price <= 0
            || stockInvalid
            || newItem.CurrencyId == 0
            || newItem.CategoryId == 0)
        {
            feedbackMessage = "Por favor completa todos los campos obligatorios y usa valores válidos.";
            feedbackClass = "alert alert-warning";
            return;
        }

        newItem.Taxes = taxes.Where(t => selectedTaxIds.Contains(t.Id)).ToList();

        var success = isEditing
            ? await ApiService.UpdateItemAsync(newItem)
            : await ApiService.SaveItemAsync(newItem);

        if (success)
        {
            feedbackMessage = isEditing ? "Cambios guardados correctamente." : "Artículo guardado correctamente.";
            feedbackClass = "alert alert-success";
            if (!isEditing)
            {
                newItem = new();
                selectedTaxIds.Clear();
            }
            await OnItemSaved.InvokeAsync();
        }
        else
        {
            feedbackMessage = "No se pudo guardar el artículo. Verifica que el SKU no esté duplicado y que la API esté disponible.";
            feedbackClass = "alert alert-danger";
        }
    }
}
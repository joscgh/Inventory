@page "/categories"
@using Inventory.Core.Classes
@using Inventory.SharedUI.Services
@inject CategoryApiService CategoryService

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title">📁 Administrar categorías</h3>
                    <p class="text-muted">Crea y administra categorías para los productos del inventario.</p>

                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input class="form-control" @bind="categoryModel.Name" placeholder="Automoción" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea class="form-control" @bind="categoryModel.Description" rows="3" placeholder="Ej.: repuestos para mantenimiento automotriz"></textarea>
                    </div>

                    <button class="btn btn-primary" @onclick="SaveCategory">Guardar categoría</button>

                    @if (!string.IsNullOrEmpty(message))
                    {
                        <div class="alert @messageClass mt-3" role="alert">
                            @message
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title">Categorías existentes</h3>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Descripción</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!categories.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-muted">Todavía no hay categorías guardadas.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var category in categories)
                                    {
                                        <tr>
                                            <td>@category.Name</td>
                                            <td>@category.Description</td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-secondary me-2" @onclick="() => EditCategory(category)">Editar</button>
                                                <button class="btn btn-danger btn-sm" @onclick="() => DeleteCategory(category.Id)">Eliminar</button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Category> categories = new();
    private Category categoryModel = new();
    private string message = string.Empty;
    private string messageClass = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        categories = await CategoryService.GetCategoriesAsync();
        message = string.Empty;
    }

    private async Task SaveCategory()
    {
        message = string.Empty;
        messageClass = string.Empty;

        if (string.IsNullOrWhiteSpace(categoryModel.Name))
        {
            message = "Escribe un nombre de categoría válido.";
            messageClass = "alert alert-warning";
            return;
        }

        var success = await CategoryService.SaveCategoryAsync(categoryModel);
        if (success)
        {
            message = "La categoría se guardó correctamente.";
            messageClass = "alert alert-success";
            categoryModel = new Category();
            await LoadCategories();
        }
        else
        {
            message = "No se pudo guardar la categoría. Es posible que ya exista.";
            messageClass = "alert alert-danger";
        }
    }

    private void EditCategory(Category category)
    {
        categoryModel = new Category
        {
            Id = category.Id,
            Name = category.Name,
            Description = category.Description
        };
    }

    private async Task DeleteCategory(int id)
    {
        var success = await CategoryService.DeleteCategoryAsync(id);
        if (success)
        {
            await LoadCategories();
        }
        else
        {
            message = "No se pudo eliminar la categoría.";
            messageClass = "alert alert-danger";
        }
    }
}

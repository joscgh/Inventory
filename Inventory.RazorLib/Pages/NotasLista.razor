@page "/notas"
@using Inventory.Core.Classes
@using Inventory.RazorLib.Services
@inject NoteApiService NoteApi

<div class="container-fluid mt-4">
    <div class="page-header mb-4">
        <div class="page-title-block">
            <h2 class="mb-2">📋 Notas de entrega y pedido</h2>
            <p class="text-muted mb-0">Consulta y filtra las notas registradas por fecha, código y tipo.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-secondary" href="/inventory">← Volver al inventario</a>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Tipo</label>
                    <select class="form-select" @bind="selectedType" @bind:after="ApplyFilters">
                        <option value="all">Todos</option>
                        <option value="Entrega">Entrega</option>
                        <option value="Pedido">Pedido</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Código</label>
                    <input class="form-control" placeholder="Ej. ENT-2026" @bind="filterCode" @bind:event="oninput" @onkeyup="ApplyFilters" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Desde</label>
                    <input type="date" class="form-control" @bind="filterDateFrom" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Hasta</label>
                    <input type="date" class="form-control" @bind="filterDateTo" />
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button class="btn btn-primary w-100" @onclick="ApplyFilters">Filtrar</button>
                    <button class="btn btn-outline-secondary" @onclick="ClearFilters">Limpiar</button>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="alert alert-light border">Cargando notas...</div>
    }
    else if (!filteredNotes.Any())
    {
        <div class="alert alert-info">No hay notas que coincidan con los filtros seleccionados.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title mb-0">Resultados</h5>
                    <span class="text-muted">@filteredNotes.Count nota(s)</span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Tipo</th>
                                <th>Fecha</th>
                                <th>Cliente</th>
                                <th>Depósito / Tienda</th>
                                <th class="text-end">Cantidad</th>
                                <th>Moneda</th>
                                <th class="text-end">Total (Bs)</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var note in filteredNotes)
                            {
                                <tr>
                                    <td><strong>@note.NoteNumber</strong></td>
                                    <td><span class="badge @GetBadgeClass(note.Type)">@GetTypeLabel(note.Type)</span></td>
                                    <td>@note.IssueDate.ToString("dd/MM/yyyy")</td>
                                    <td>@(string.IsNullOrWhiteSpace(note.CustomerName) ? "Sin cliente" : note.CustomerName)</td>
                                    <td>
                                        <small class="d-block">@(note.Warehouse?.Name ?? "—")</small>
                                        <small class="d-block text-muted">@(note.Store?.Name ?? "—")</small>
                                    </td>
                                    <td class="text-end">@TotalQuantity(note).ToString("N2")</td>
                                    <td>@GetCurrencyLabel(note)</td>
                                    <td class="text-end">
                                        <div><strong>Bs @TotalBs(note).ToString("N2")</strong></div>
                                        @if (GetCurrencyLabel(note) != "Bs")
                                        {
                                            <small class="text-muted">@GetCurrencyLabel(note) @note.Total.ToString("N2")</small>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowDetail(note)">
                                            👁️ Ver detalle
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@if (selectedNote != null)
{
    <div class="modal fade show" style="display:block;" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <span class="badge @GetBadgeClass(selectedNote.Type) me-2">@GetTypeLabel(selectedNote.Type)</span>
                        @selectedNote.NoteNumber
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseDetail"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <div class="text-muted small">Cliente</div>
                            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(selectedNote.CustomerName) ? "Sin cliente" : selectedNote.CustomerName)</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small">Documento</div>
                            <div>@(string.IsNullOrWhiteSpace(selectedNote.CustomerDocument) ? "—" : selectedNote.CustomerDocument)</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small">Fecha de emisión</div>
                            <div>@selectedNote.IssueDate.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted small">Creada por</div>
                            <div>@(selectedNote.CreatedByUser?.FullName ?? "—")</div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(selectedNote.CustomerAddress))
                        {
                            <div class="col-12">
                                <div class="text-muted small">Dirección</div>
                                <div>@selectedNote.CustomerAddress</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(selectedNote.ValidityPeriod))
                        {
                            <div class="col-sm-6">
                                <div class="text-muted small">Vigencia</div>
                                <div>@selectedNote.ValidityPeriod</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(selectedNote.Notes))
                        {
                            <div class="col-12">
                                <div class="text-muted small">Observaciones</div>
                                <div>@selectedNote.Notes</div>
                            </div>
                        }
                    </div>

                    <h6 class="text-secondary">Productos</h6>
                    @if (selectedNote.Lines == null || !selectedNote.Lines.Any())
                    {
                        <div class="alert alert-info">Esta nota no tiene productos registrados.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th class="text-end">Cant.</th>
                                        <th class="text-end">P. Unit.</th>
                                        <th class="text-end">% IVA</th>
                                        <th class="text-end">Subtotal (Bs)</th>
                                        <th class="text-end">Total (Bs)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in selectedNote.Lines)
                                    {
                                        <tr>
                                            <td>
                                                @line.Description
                                                @if (!string.IsNullOrWhiteSpace(line.Item?.SKU))
                                                {
                                                    <div class="text-muted small">@line.Item!.SKU</div>
                                                }
                                            </td>
                                            <td class="text-end">@line.Quantity.ToString("N2")</td>
                                            <td class="text-end">@line.UnitPrice.ToString("N2")</td>
                                            <td class="text-end">@line.TaxRate.ToString("N2")%</td>
                                            <td class="text-end">@line.SubtotalBs.ToString("N2")</td>
                                            <td class="text-end">@line.TotalBs.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-3">
                            <div class="d-flex justify-content-between">
                                <span>Subtotal (Bs)</span>
                                <strong>Bs @selectedNote.Lines.Sum(l => l.SubtotalBs).ToString("N2")</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Total impuestos (Bs)</span>
                                <strong>Bs @selectedNote.Lines.Sum(l => l.TaxAmountBs).ToString("N2")</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="fw-bold">Total (Bs)</span>
                                <strong>Bs @TotalBs(selectedNote).ToString("N2")</strong>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDetail">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<Note> allNotes = new();
    private List<Note> filteredNotes = new();
    private bool isLoading = true;
    private string selectedType = "all";
    private string filterCode = string.Empty;
    private DateTime? filterDateFrom;
    private DateTime? filterDateTo;
    private Note? selectedNote;

    private void ShowDetail(Note note) => selectedNote = note;

    private void CloseDetail() => selectedNote = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadNotesAsync();
    }

    private async Task LoadNotesAsync()
    {
        isLoading = true;
        try
        {
            allNotes = await NoteApi.GetNotesAsync();
            ApplyFilters();
        }
        catch (Exception)
        {
            filteredNotes = new List<Note>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        var normalizedCode = filterCode?.Trim() ?? string.Empty;
        var startDate = filterDateFrom?.Date;
        var endDate = filterDateTo?.Date;

        filteredNotes = allNotes
            .Where(note => selectedType == "all" || note.Type.ToString() == selectedType)
            .Where(note => string.IsNullOrWhiteSpace(normalizedCode) || note.NoteNumber.Contains(normalizedCode, StringComparison.OrdinalIgnoreCase))
            .Where(note => !startDate.HasValue || note.IssueDate.Date >= startDate.Value)
            .Where(note => !endDate.HasValue || note.IssueDate.Date <= endDate.Value)
            .OrderByDescending(note => note.IssueDate)
            .ToList();
    }

    private void ClearFilters()
    {
        selectedType = "all";
        filterCode = string.Empty;
        filterDateFrom = null;
        filterDateTo = null;
        ApplyFilters();
    }

    private static string GetTypeLabel(NoteType type) => type switch
    {
        NoteType.Entrega => "Entrega",
        NoteType.Pedido => "Pedido",
        _ => "Crédito"
    };

    private static string GetBadgeClass(NoteType type) => type switch
    {
        NoteType.Entrega => "bg-primary",
        NoteType.Pedido => "bg-secondary",
        _ => "bg-warning text-dark"
    };

    private static decimal TotalQuantity(Note note) =>
        note.Lines?.Sum(l => l.Quantity) ?? 0m;

    private static decimal TotalBs(Note note)
    {
        var rate = note.ExchangeRate.HasValue && note.ExchangeRate.Value > 0 ? note.ExchangeRate.Value : 1m;
        return note.Total * rate;
    }

    private static string GetCurrencyLabel(Note note)
    {
        if (note.Currency != null && !string.IsNullOrWhiteSpace(note.Currency.Code))
        {
            return note.Currency.Code;
        }

        if (note.ExchangeRate.HasValue && note.ExchangeRate.Value > 0)
        {
            return "USD";
        }

        return "Bs";
    }
}

@page "/nota-credito"
@using Inventory.Core.Classes
@using Inventory.SharedUI.Services
@using Microsoft.JSInterop
@inject NoteApiService NoteApi
@inject CustomerAccountApiService AccountApi
@inject UserStateService UserState
@inject IJSRuntime JSRuntime

<div class="container-fluid mt-4">
    <div class="page-header mb-4">
        <div class="page-title-block">
            <h2 class="mb-2">💳 Nota de Crédito</h2>
            <p class="text-muted mb-0">Registra una nota de crédito ligada a una nota de entrega y al cliente correspondiente.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-secondary" href="/inventory">← Volver al inventario</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Datos de la nota de crédito</h5>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label">Número de nota</label>
                            <input class="form-control" @bind="noteNumber" readonly />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Fecha</label>
                            <input type="date" class="form-control" @bind="issueDate" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Nota de entrega origen</label>
                            <select class="form-select" value="@selectedReferenceNoteId" @onchange="OnReferenceNoteChanged">
                                <option value="0">Seleccione una nota de entrega</option>
                                @foreach (var note in deliveryNotes)
                                {
                                    <option value="@note.Id">@note.NoteNumber - @note.CustomerName</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Cliente</label>
                            <input class="form-control" value="@selectedCustomerName" readonly />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Documento</label>
                            <input class="form-control" value="@selectedCustomerDocument" readonly />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Dirección</label>
                            <textarea class="form-control" rows="2" value="@selectedCustomerAddress" readonly></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Observaciones</label>
                            <textarea class="form-control" @bind="notes" rows="2" placeholder="Motivo de la nota de crédito"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="card-body">
                    <h5 class="card-title">Detalle de la nota de crédito</h5>
                    @if (!creditLines.Any())
                    {
                        <div class="alert alert-info">Selecciona una nota de entrega para ver sus productos y ajustar cantidades.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th class="text-end">Cant. entregada</th>
                                        <th class="text-end">Cant. acreditada</th>
                                        <th class="text-end">Unit.</th>
                                        <th class="text-end">IVA</th>
                                        <th class="text-end">Total Bs</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in creditLines)
                                    {
                                        <tr>
                                            <td>@line.Description</td>
                                            <td class="text-end">@line.Quantity</td>
                                            <td class="text-end">@line.CommittedQuantity</td>
                                            <td class="text-end">@line.UnitPrice.ToString("N2")</td>
                                            <td class="text-end">@line.TaxRate.ToString("N2")%</td>
                                            <td class="text-end">Bs @line.TotalBs.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Resumen</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <strong>Bs @SubtotalBs.ToString("N2")</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Impuesto</span>
                        <strong>Bs @TotalTaxBs.ToString("N2")</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Total</span>
                        <strong>Bs @GrandTotalBs.ToString("N2")</strong>
                    </div>

                    <div class="mt-4 d-flex flex-wrap gap-2 justify-content-end">
                        <button class="btn btn-secondary" @onclick="SaveCreditNote" disabled="@(!CanSaveCreditNote)">Guardar nota de crédito</button>
                        <button class="btn btn-success" @onclick="PrintCreditNote">Imprimir nota</button>
                    </div>
                    @if (!string.IsNullOrEmpty(saveMessage))
                    {
                        <div class="alert @saveMessageClass mt-3">@saveMessage</div>
                    }
                </div>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="card-body">
                    <h5 class="card-title">Notas de crédito existentes</h5>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Nota</th>
                                    <th>Cliente</th>
                                    <th class="text-end">Total Bs</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var note in creditNotes)
                                {
                                    <tr>
                                        <td>@note.NoteNumber</td>
                                        <td>@note.CustomerName</td>
                                        <td class="text-end">Bs @note.Total.ToString("N2")</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ViewCreditNoteDetail(note)">Ver</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Note> deliveryNotes = new();
    private List<Note> creditNotes = new();
    private List<NoteLine> creditLines = new();
    private Note? selectedReferenceNote;
    private string noteNumber = string.Empty;
    private DateTime issueDate = DateTime.Today;
    private int selectedReferenceNoteId;
    private string selectedCustomerName = string.Empty;
    private string selectedCustomerDocument = string.Empty;
    private string selectedCustomerAddress = string.Empty;
    private string notes = string.Empty;
    private string saveMessage = string.Empty;
    private string saveMessageClass = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        noteNumber = GenerateNoteNumber("CRE");
        await LoadDeliveryNotes();
        await LoadCreditNotes();
    }

    private async Task LoadDeliveryNotes()
    {
        deliveryNotes = await NoteApi.GetNotesByTypeAsync(NoteType.Entrega);
    }

    private async Task LoadCreditNotes()
    {
        creditNotes = await NoteApi.GetNotesByTypeAsync(NoteType.Credito);
    }

    private async Task OnReferenceNoteChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args?.Value?.ToString(), out var noteId) || noteId <= 0)
        {
            selectedReferenceNote = null;
            creditLines.Clear();
            selectedCustomerName = selectedCustomerDocument = selectedCustomerAddress = string.Empty;
            return;
        }

        selectedReferenceNoteId = noteId;
        selectedReferenceNote = deliveryNotes.FirstOrDefault(n => n.Id == noteId);

        if (selectedReferenceNote == null)
        {
            creditLines.Clear();
            selectedCustomerName = selectedCustomerDocument = selectedCustomerAddress = string.Empty;
            return;
        }

        selectedCustomerName = selectedReferenceNote.CustomerName;
        selectedCustomerDocument = selectedReferenceNote.CustomerDocument;
        selectedCustomerAddress = selectedReferenceNote.CustomerAddress;

        creditLines = selectedReferenceNote.Lines.Select(l => new NoteLine
        {
            ItemUniversalId = l.ItemUniversalId,
            CategoryId = l.CategoryId,
            CurrencyId = l.CurrencyId,
            Currency = l.Currency,
            Description = l.Description,
            Quantity = l.Quantity,
            CommittedQuantity = l.Quantity,
            UnitPrice = l.UnitPrice,
            TaxRate = l.TaxRate
        }).ToList();
    }

    private decimal SubtotalBs => creditLines.Sum(l => l.SubtotalBs);
    private decimal TotalTaxBs => creditLines.Sum(l => l.TaxAmountBs);
    private decimal GrandTotalBs => creditLines.Sum(l => l.TotalBs);

    private bool CanSaveCreditNote => selectedReferenceNote != null && creditLines.Any();

    private async Task SaveCreditNote()
    {
        saveMessage = string.Empty;
        saveMessageClass = string.Empty;

        var currentUser = await UserState.GetCurrentUserAsync();
        if (currentUser == null)
        {
            saveMessage = "Debe iniciar sesión para guardar la nota de crédito.";
            saveMessageClass = "alert-danger";
            return;
        }

        if (selectedReferenceNote == null)
        {
            saveMessage = "Seleccione una nota de entrega de referencia.";
            saveMessageClass = "alert-warning";
            return;
        }

        var creditNote = new Note
        {
            Type = NoteType.Credito,
            NoteNumber = noteNumber,
            IssueDate = DateTime.SpecifyKind(issueDate, DateTimeKind.Utc),
            CustomerName = selectedCustomerName,
            CustomerDocument = selectedCustomerDocument,
            CustomerAddress = selectedCustomerAddress,
            Notes = notes,
            CustomerAccountId = selectedReferenceNote.CustomerAccountId,
            CreatedByUserId = currentUser.UserId,
            ReferenceNoteId = selectedReferenceNote.Id,
            Lines = creditLines.Select(l => new NoteLine
            {
                ItemUniversalId = l.ItemUniversalId,
                CategoryId = l.CategoryId,
                CurrencyId = l.CurrencyId,
                Description = l.Description,
                Quantity = l.Quantity,
                CommittedQuantity = l.CommittedQuantity,
                UnitPrice = l.UnitPrice,
                TaxRate = l.TaxRate
            }).ToList()
        };

        var (success, errorMessage) = await NoteApi.SaveNoteAsync(creditNote);
        if (success)
        {
            saveMessage = "Nota de crédito guardada correctamente.";
            saveMessageClass = "alert-success";
            noteNumber = GenerateNoteNumber("CRE");
            notes = string.Empty;
            selectedReferenceNoteId = 0;
            selectedReferenceNote = null;
            creditLines.Clear();
            await LoadCreditNotes();
        }
        else
        {
            saveMessage = string.IsNullOrWhiteSpace(errorMessage)
                ? "Ocurrió un error al guardar la nota de crédito."
                : $"Ocurrió un error al guardar la nota de crédito: {errorMessage}";
            saveMessageClass = "alert-danger";
        }
    }

    private Task PrintCreditNote()
    {
        return JSRuntime.InvokeVoidAsync("window.print").AsTask();
    }

    private void ViewCreditNoteDetail(Note note)
    {
        selectedReferenceNote = note;
        creditLines = note.Lines;
        selectedCustomerName = note.CustomerName;
        selectedCustomerDocument = note.CustomerDocument;
        selectedCustomerAddress = note.CustomerAddress;
        selectedReferenceNoteId = note.ReferenceNoteId ?? note.Id;
    }

    private static string GenerateNoteNumber(string prefix)
    {
        return $"{prefix}-{DateTime.Now:yyyyMMddHHmmss}";
    }
}

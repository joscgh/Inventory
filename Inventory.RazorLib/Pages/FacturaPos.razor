@page "/facturacion"
@using Inventory.Core.Classes
@using Inventory.SharedUI.Services
@inject InvoiceApiService InvoiceApi
@inject ItemApiService ItemApi
@inject UserStateService UserState

<div class="container-fluid mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Facturacion POS</h1>
            <p class="text-muted mb-0">Busca productos, cobra y emite la factura.</p>
        </div>
        <button class="btn btn-outline-secondary" @onclick="ToggleCloseout">Resumen de caja</button>
    </div>

    @if (showCloseout)
    {
        <div class="alert alert-light border mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <strong>Caja abierta</strong>
                    <span class="text-muted ms-2">@sessionInvoiceCount factura(s), @sessionTotal.ToString("N2") acumulado</span>
                </div>
                <button class="btn btn-warning" @onclick="CloseSession" disabled="@(sessionInvoiceCount == 0)">Cerrar caja</button>
            </div>
        </div>
    }

    <div class="row g-4">
        <div class="col-xl-7">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Terminal</label>
                            <input type="number" min="1" class="form-control" @bind="terminalId" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Cuenta comercial</label>
                            <input type="number" min="1" class="form-control" @bind="customerAccountId" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Usuario</label>
                            <input type="number" min="1" class="form-control" @bind="createdByUserId" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Cliente</label>
                            <input class="form-control" @bind="customerName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Documento</label>
                            <input class="form-control" @bind="customerDocument" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                        <h2 class="h5 mb-0">Productos</h2>
                        <input class="form-control" style="max-width: 22rem" placeholder="Buscar nombre, SKU o codigo" @bind="searchText" @bind:event="oninput" />
                    </div>

                    <div class="row g-2 mb-3">
                        @foreach (var item in FilteredItems.Take(12))
                        {
                            <div class="col-sm-6 col-lg-4">
                                <button class="btn btn-outline-primary w-100 text-start h-100" @onclick="() => SelectItem(item)">
                                    <strong class="d-block">@item.Name</strong>
                                    <small>@item.SKU - @item.PriceWithTax.ToString("N2")</small>
                                </button>
                            </div>
                        }
                    </div>

                    @if (selectedItem != null)
                    {
                        <div class="border rounded p-3 bg-light">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-5">
                                    <strong>@selectedItem.Name</strong>
                                    <div class="small text-muted">@selectedItem.SKU</div>
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label">Cantidad</label>
                                    <input type="number" min="0.01" step="0.01" class="form-control" @bind="selectedQuantity" />
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label">Precio</label>
                                    <input type="number" min="0" step="0.01" class="form-control" @bind="selectedUnitPrice" />
                                </div>
                                <div class="col-md-3">
                                    <button class="btn btn-primary w-100" @onclick="AddLine" disabled="@(!CanAddLine)">Agregar</button>
                                </div>
                            </div>
                        </div>
                    }
                    else if (!items.Any())
                    {
                        <div class="alert alert-warning mb-0">No hay productos disponibles.</div>
                    }
                    else
                    {
                        <div class="text-muted">Selecciona un producto para agregarlo al carrito.</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-3">Carrito</h2>
                    @if (!invoiceLines.Any())
                    {
                        <div class="alert alert-info">El carrito esta vacio.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead><tr><th>Producto</th><th>Cant.</th><th class="text-end">Total</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var line in invoiceLines)
                                    {
                                        <tr>
                                            <td>@line.Description<br /><small class="text-muted">@line.UnitPrice.ToString("N2") + @line.TaxRate.ToString("N2")% IVA</small></td>
                                            <td>@line.Quantity.ToString("N2")</td>
                                            <td class="text-end">@line.Total.ToString("N2")</td>
                                            <td><button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveLine(line)">X</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="border-top pt-3">
                        <div class="d-flex justify-content-between"><span>Subtotal</span><strong>@subtotal.ToString("N2")</strong></div>
                        <div class="d-flex justify-content-between"><span>IVA</span><strong>@taxTotal.ToString("N2")</strong></div>
                        <div class="d-flex justify-content-between fs-4"><span>Total</span><strong>@grandTotal.ToString("N2")</strong></div>
                    </div>

                    <div class="border-top mt-3 pt-3">
                        <h2 class="h6">Cobro</h2>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label">Metodo</label>
                                <select class="form-select" @bind="paymentMethod">
                                    <option>Efectivo</option>
                                    <option>Tarjeta</option>
                                    <option>Transferencia</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label">Recibido</label>
                                <input type="number" min="0" step="0.01" class="form-control" @bind="amountReceived" />
                            </div>
                        </div>
                        <div class="d-grid mt-2" style="grid-template-columns: repeat(3, 1fr); gap: .5rem">
                            @foreach (var amount in keypadAmounts)
                            {
                                <button class="btn btn-outline-secondary" @onclick="() => AddPaymentAmount(amount)">@amount.ToString("N0")</button>
                            }
                            <button class="btn btn-outline-secondary" @onclick="ClearPayment">Limpiar</button>
                        </div>
                        <div class="d-flex justify-content-between mt-3">
                            <span>Cambio</span><strong>@change.ToString("N2")</strong>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(statusMessage))
                    {
                        <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3">@statusMessage</div>
                    }
                    <button class="btn btn-success btn-lg w-100 mt-3" @onclick="SaveInvoice" disabled="@(!CanSaveInvoice)">Cobrar y emitir factura</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int terminalId = 1;
    private int customerAccountId = 1;
    private int createdByUserId = 1;
    private string customerName = "Cliente de contado";
    private string customerDocument = string.Empty;
    private string searchText = string.Empty;
    private string paymentMethod = "Efectivo";
    private decimal selectedQuantity = 1m;
    private decimal selectedUnitPrice;
    private decimal amountReceived;
    private bool isError;
    private bool showCloseout;
    private string statusMessage = string.Empty;
    private ItemUniversal? selectedItem;
    private List<ItemUniversal> items = new();
    private List<InvoiceLine> invoiceLines = new();
    private int sessionInvoiceCount;
    private decimal sessionTotal;
    private readonly decimal[] keypadAmounts = { 1m, 5m, 10m, 20m, 50m, 100m };

    private IEnumerable<ItemUniversal> FilteredItems => items.Where(item =>
        string.IsNullOrWhiteSpace(searchText)
        || item.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase)
        || item.SKU.Contains(searchText, StringComparison.OrdinalIgnoreCase)
        || (item.Barcode?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false));

    private bool CanAddLine => selectedItem != null && selectedQuantity > 0m && selectedUnitPrice >= 0m;
    private bool CanSaveInvoice => invoiceLines.Count > 0 && terminalId > 0 && customerAccountId > 0 && createdByUserId > 0 && amountReceived >= grandTotal;
    private decimal subtotal => invoiceLines.Sum(line => line.Subtotal);
    private decimal taxTotal => invoiceLines.Sum(line => line.TaxAmount);
    private decimal grandTotal => invoiceLines.Sum(line => line.Total);
    private decimal change => Math.Max(0m, amountReceived - grandTotal);

    protected override async Task OnInitializedAsync()
    {
        items = await ItemApi.GetItemsAsync();
        var user = await UserState.GetCurrentUserAsync();
        if (user != null)
        {
            createdByUserId = user.UserId;
            customerAccountId = user.AccountId;
        }
    }

    private void SelectItem(ItemUniversal item)
    {
        selectedItem = item;
        selectedQuantity = 1m;
        selectedUnitPrice = item.Price;
        statusMessage = string.Empty;
    }

    private void AddLine()
    {
        if (selectedItem == null) return;

        var existing = invoiceLines.FirstOrDefault(line => line.ItemUniversalId == selectedItem.Id && line.UnitPrice == selectedUnitPrice);
        if (existing != null)
        {
            existing.Quantity += selectedQuantity;
        }
        else
        {
            invoiceLines.Add(new InvoiceLine
            {
                ItemUniversalId = selectedItem.Id,
                Item = selectedItem,
                Code = selectedItem.SKU,
                Description = selectedItem.Name,
                Quantity = selectedQuantity,
                UnitPrice = selectedUnitPrice,
                TaxRate = selectedItem.EffectiveTaxRate,
                CurrencyId = selectedItem.CurrencyId,
                CategoryId = selectedItem.CategoryId,
                ExchangeRate = 1m
            });
        }

        amountReceived = grandTotal;
        statusMessage = $"Agregado: {selectedItem.Name}.";
        isError = false;
        selectedItem = null;
    }

    private void RemoveLine(InvoiceLine line)
    {
        invoiceLines.Remove(line);
        amountReceived = Math.Min(amountReceived, grandTotal);
    }

    private void AddPaymentAmount(decimal amount) => amountReceived += amount;

    private void ClearPayment() => amountReceived = 0m;

    private void ToggleCloseout() => showCloseout = !showCloseout;

    private void CloseSession()
    {
        statusMessage = $"Caja cerrada: {sessionInvoiceCount} factura(s), total {sessionTotal.ToString("N2")}.";
        sessionInvoiceCount = 0;
        sessionTotal = 0m;
        isError = false;
    }

    private async Task SaveInvoice()
    {
        if (!CanSaveInvoice)
        {
            isError = true;
            statusMessage = "Completa el carrito y verifica el monto recibido.";
            return;
        }

        var draft = InvoiceApiService.BuildDraftInvoice(
            terminalId,
            customerAccountId,
            createdByUserId,
            customerName,
            customerDocument,
            invoiceLines.Select(line => new InvoiceApiService.InvoiceLineDraft(
                line.Item ?? new ItemUniversal { Id = line.ItemUniversalId ?? 0, Name = line.Description, SKU = line.Code, TaxRate = line.TaxRate, CurrencyId = line.CurrencyId ?? 1, CategoryId = line.CategoryId ?? 0 },
                line.Quantity,
                line.UnitPrice,
                line.TaxRate,
                line.Discount,
                line.Description)));

        var (success, created, error) = await InvoiceApi.CreateInvoiceAsync(draft);
        if (!success || created == null)
        {
            isError = true;
            statusMessage = error ?? "No se pudo emitir la factura.";
            return;
        }

        sessionInvoiceCount++;
        sessionTotal += created.Total;
        isError = false;
        statusMessage = $"Factura emitida: {created.Serie}-{created.Number}. Cambio: {change.ToString("N2")}.";
        invoiceLines.Clear();
        amountReceived = 0m;
        selectedItem = null;
    }
}

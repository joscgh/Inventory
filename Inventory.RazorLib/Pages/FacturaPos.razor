@page "/facturacion"
@using Inventory.Core.Classes
@using Inventory.Core.Services
@using Inventory.SharedUI.Components
@using Inventory.SharedUI.Services
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject InvoiceApiService InvoiceApi
@inject ItemApiService ItemApi
@inject CurrencyApiService CurrencyApi
@inject PaymentApiService PaymentApi
@inject UserStateService UserState
@inject OfflineStorageService OfflineStorage
@inject OfflineInvoiceQueueService OfflineQueue
@inject IJSRuntime JS

<div class="container-fluid mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Facturacion POS</h1>
            <p class="text-muted mb-0">Busca productos, cobra y emite la factura.</p>
            @if (isOffline)
            {
                <span class="badge bg-warning text-dark">Modo offline: @pendingInvoices pendientes</span>
            }
        </div>
        <button class="btn btn-outline-secondary" @onclick="ToggleCloseout">Resumen de caja</button>
    </div>

    @if (showCloseout)
    {
        <div class="alert alert-light border mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <strong>Caja abierta</strong>
                    <span class="text-muted ms-2">@sessionInvoiceCount factura(s), @sessionTotal.ToString("N2") acumulado</span>
                </div>
                <button class="btn btn-warning" @onclick="CloseSession" disabled="@(sessionInvoiceCount == 0)">Cerrar caja</button>
            </div>
        </div>
    }

    <div class="row g-4">
        <div class="col-xl-7">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Terminal</label>
                            <select class="form-select" @bind="terminalId" @bind:after="OnTerminalChanged">
                                <option value="0">Seleccione una caja</option>
                                @foreach (var terminal in terminals)
                                {
                                    <option value="@terminal.Id">@terminal.Code - @terminal.Name</option>
                                }
                            </select>
                            @if (terminals.Count == 0)
                            {
                                <small class="text-danger">No hay una caja configurada para esta cuenta.</small>
                            }
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Cuenta comercial</label>
                            <input class="form-control" value="@accountName" readonly />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Usuario</label>
                            <input class="form-control" value="@userName" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Cliente</label>
                            <input class="form-control" @bind="customerName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Documento</label>
                            <input class="form-control" @bind="customerDocument" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Modalidad fiscal</label>
                            <select class="form-select" @bind="emissionMode">
                                <option value="@InvoiceEmissionMode.FormaLibre">Forma libre</option>
                                <option value="@InvoiceEmissionMode.Digital">Facturación digital</option>
                                <option value="@InvoiceEmissionMode.MaquinaFiscal">Máquina fiscal</option>
                            </select>
                            <small class="text-muted">Digital y máquina fiscal requieren proveedor o equipo configurado.</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                        <h2 class="h5 mb-0">Productos</h2>
                        <input class="form-control" style="max-width: 22rem" placeholder="Buscar nombre, SKU o codigo" @bind="searchText" @bind:event="oninput" />
                    </div>

                    <div class="input-group mb-3">
                        <span class="input-group-text">Escanear</span>
                        <input class="form-control" @bind="scanCode" @onkeydown="HandleScanKeyDown"
                               placeholder="Codigo de barras y Enter" autocomplete="off" />
                        <button class="btn btn-outline-primary" type="button" @onclick="ScanProduct">Agregar</button>
                    </div>

                    <BarcodeScanner OnScanned="AddScannedProduct" />

                    <div class="row g-2 mb-3">
                        @foreach (var item in FilteredItems.Take(12))
                        {
                            <div class="col-sm-6 col-lg-4">
                                <button class="btn btn-outline-primary w-100 text-start h-100" @onclick="() => SelectItem(item)">
                                    <strong class="d-block">@item.Name</strong>
                                    <small>@item.SKU - @PriceInBolivars(item, item.PriceWithTax).ToString("N2") Bs</small>
                                </button>
                            </div>
                        }
                    </div>

                    @if (selectedItem != null)
                    {
                        <div class="border rounded p-3 bg-light">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-5">
                                    <strong>@selectedItem.Name</strong>
                                    <div class="small text-muted">@selectedItem.SKU | Precio en Bs</div>
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label">Cantidad</label>
                                    <input type="number" min="0.01" step="0.01" class="form-control" @bind="selectedQuantity" />
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label">Precio (Bs)</label>
                                    <input type="number" min="0" step="0.01" class="form-control" @bind="selectedUnitPrice" />
                                </div>
                                <div class="col-md-3">
                                    <button class="btn btn-primary w-100" @onclick="AddLine" disabled="@(!CanAddLine)">Agregar</button>
                                </div>
                            </div>
                        </div>
                    }
                    else if (!items.Any())
                    {
                        <div class="alert alert-warning mb-0">No hay productos disponibles.</div>
                    }
                    else
                    {
                        <div class="text-muted">Selecciona un producto para agregarlo al carrito.</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-3">Carrito</h2>
                    @if (!invoiceLines.Any())
                    {
                        <div class="alert alert-info">El carrito esta vacio.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead><tr><th>Producto</th><th>Cant.</th><th class="text-end">Total</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var line in invoiceLines)
                                    {
                                        <tr>
                                            <td>@line.Description<br /><small class="text-muted">@line.UnitPrice.ToString("N2") Bs + @line.TaxRate.ToString("N2")% IVA</small></td>
                                            <td>@line.Quantity.ToString("N2")</td>
                                            <td class="text-end">@line.Total.ToString("N2") Bs</td>
                                            <td><button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveLine(line)">X</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="border-top pt-3">
                        <div class="d-flex justify-content-between"><span>Subtotal (Bs)</span><strong>@subtotal.ToString("N2") Bs</strong></div>
                        <div class="d-flex justify-content-between"><span>IVA (Bs)</span><strong>@taxTotal.ToString("N2") Bs</strong></div>
                        <div class="d-flex justify-content-between fs-4"><span>Total (Bs)</span><strong>@grandTotal.ToString("N2") Bs</strong></div>
                    </div>

                    <div class="border-top mt-3 pt-3">
                        <h2 class="h6">Cobro</h2>
                        @if (!exchangeRateReady)
                        {
                            <div class="alert alert-warning py-2">No se pudo obtener la tasa BCV. Los productos en USD no pueden cobrarse hasta actualizarla.</div>
                        }
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label">Metodo</label>
                                <select class="form-select" @bind="paymentMethod">
                                    @foreach (var method in paymentMethods)
                                    {
                                        <option value="@method.Name">@method.Name</option>
                                    }
                                </select>
                                @if (paymentMethod.Equals("Pago móvil", StringComparison.OrdinalIgnoreCase))
                                {
                                    <input class="form-control mt-2" @bind="mobileReference" placeholder="Referencia Pago Móvil" />
                                }
                                @if (paymentMethod.Equals("Tarjeta", StringComparison.OrdinalIgnoreCase))
                                {
                                    <input class="form-control mt-2" @bind="debitReference" placeholder="Referencia del POS" />
                                }
                            </div>
                            <div class="col-6">
                                <label class="form-label">Recibido (Bs)</label>
                                <input type="number" min="0" step="0.01" class="form-control" @bind="amountReceived" />
                            </div>
                        </div>
                        <div class="d-grid mt-2" style="grid-template-columns: repeat(3, 1fr); gap: .5rem">
                            @foreach (var amount in keypadAmounts)
                            {
                                <button class="btn btn-outline-secondary" @onclick="() => AddPaymentAmount(amount)">@amount.ToString("N0") Bs</button>
                            }
                            <button class="btn btn-outline-secondary" @onclick="ClearPayment">Limpiar</button>
                        </div>
                        <div class="d-flex justify-content-between mt-3">
                            <span>Cambio (Bs)</span><strong>@change.ToString("N2") Bs</strong>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(statusMessage))
                    {
                        <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3">@statusMessage</div>
                    }
                    <button class="btn btn-success btn-lg w-100 mt-3" @onclick="SaveInvoice" disabled="@(!CanSaveInvoice)">@(isOffline ? "Guardar factura offline" : "Cobrar y emitir factura")</button>
                    @if (pendingInvoices > 0 && !isOffline)
                    {
                        <button class="btn btn-outline-primary w-100 mt-2" @onclick="SynchronizePending">Sincronizar @pendingInvoices pendiente(s)</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int terminalId;
    private int customerAccountId;
    private int createdByUserId;
    private string accountName = string.Empty;
    private string userName = string.Empty;
    private string customerName = "Cliente de contado";
    private string customerDocument = string.Empty;
    private InvoiceEmissionMode emissionMode = InvoiceEmissionMode.FormaLibre;
    private string searchText = string.Empty;
    private string scanCode = string.Empty;
    private string paymentMethod = "Efectivo";
    private string mobileReference = string.Empty;
    private string debitReference = string.Empty;
    private List<TerminalPaymentMethod> paymentMethods = DefaultPaymentMethods();
    private decimal selectedQuantity = 1m;
    private decimal selectedUnitPrice;
    private decimal usdRate;
    private int bolivarCurrencyId;
    private bool exchangeRateReady;
    private decimal amountReceived;
    private bool isError;
    private bool showCloseout;
    private string statusMessage = string.Empty;
    private ItemUniversal? selectedItem;
    private List<ItemUniversal> items = new();
    private List<Terminal> terminals = new();
    private List<InvoiceLine> invoiceLines = new();
    private int sessionInvoiceCount;
    private decimal sessionTotal;
    private bool isOffline;
    private int pendingInvoices;
    private IJSObjectReference? offlineModule;
    private DotNetObjectReference<FacturaPos>? offlineDotNetRef;
    private string? onlineWatcherId;
    private List<Currency> currencies = new();
    private readonly decimal[] keypadAmounts = { 1m, 5m, 10m, 20m, 50m, 100m };

    private IEnumerable<ItemUniversal> FilteredItems => items.Where(item =>
        string.IsNullOrWhiteSpace(searchText)
        || item.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase)
        || item.SKU.Contains(searchText, StringComparison.OrdinalIgnoreCase)
        || (item.Barcode?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false));

    private bool CanAddLine => selectedItem != null && selectedQuantity > 0m && selectedUnitPrice >= 0m;
    private bool CanSaveInvoice => invoiceLines.Count > 0
        && terminalId > 0
        && customerAccountId > 0
        && createdByUserId > 0
        && amountReceived >= grandTotal
        && bolivarCurrencyId > 0
        && !invoiceLines.Any(line => line.Item?.Currency?.Code.Equals("USD", StringComparison.OrdinalIgnoreCase) == true && usdRate <= 0m);
    private decimal subtotal => invoiceLines.Sum(line => line.Subtotal);
    private decimal taxTotal => invoiceLines.Sum(line => line.TaxAmount);
    private decimal grandTotal => invoiceLines.Sum(line => line.Total);
    private decimal change => Math.Max(0m, amountReceived - grandTotal);

    protected override async Task OnInitializedAsync()
    {
        isOffline = !await OfflineStorage.IsOnlineAsync();
        try
        {
            await CurrencyApi.RefreshExchangeRatesAsync();
            currencies = await CurrencyApi.GetCurrenciesAsync();
            await OfflineStorage.WriteAsync("pos-currencies", currencies);
        }
        catch
        {
            isOffline = true;
            currencies = await OfflineStorage.ReadAsync<List<Currency>>("pos-currencies") ?? new();
        }
        var bolivar = currencies.FirstOrDefault(currency =>
            currency.Code.Equals("VES", StringComparison.OrdinalIgnoreCase)
            || currency.Code.Equals("BS", StringComparison.OrdinalIgnoreCase)
            || currency.Name.Contains("bolivar", StringComparison.OrdinalIgnoreCase));
        var dollar = currencies.FirstOrDefault(currency => currency.Code.Equals("USD", StringComparison.OrdinalIgnoreCase));
        bolivarCurrencyId = bolivar?.Id ?? 0;
        usdRate = dollar?.ExchangeRate ?? 0m;
        exchangeRateReady = bolivarCurrencyId > 0 && usdRate > 0m;
        var user = await UserState.GetCurrentUserAsync();
        if (user != null)
        {
            createdByUserId = user.UserId;
            customerAccountId = user.AccountId;
            accountName = user.AccountName;
            userName = $"{user.FullName} ({user.Email})";
            try
            {
                items = await ItemApi.GetItemsAsync();
                await OfflineStorage.WriteAsync($"pos-items-{customerAccountId}", items);
                terminals = (await InvoiceApi.GetTerminalsAsync(customerAccountId))
                    .Where(terminal => terminal.IsActive && terminal.StoreId.HasValue).ToList();
            }
            catch
            {
                isOffline = true;
                items = await OfflineStorage.ReadAsync<List<ItemUniversal>>($"pos-items-{customerAccountId}") ?? new();
                terminals = await OfflineStorage.ReadAsync<List<Terminal>>($"pos-terminals-{customerAccountId}") ?? new();
            }
            if (terminals.Count > 0)
            {
                await OfflineStorage.WriteAsync($"pos-terminals-{customerAccountId}", terminals);
            }
            terminalId = terminals.FirstOrDefault()?.Id ?? 0;
            if (!isOffline) await LoadPaymentMethods();
        }
        pendingInvoices = await OfflineQueue.CountAsync();
        if (!isOffline) await SynchronizePending();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        offlineModule = await JS.InvokeAsync<IJSObjectReference>("import", "/_content/Inventory.SharedUI/offlineStorage.js");
        offlineDotNetRef = DotNetObjectReference.Create(this);
        onlineWatcherId = await offlineModule.InvokeAsync<string>("watchOnline", offlineDotNetRef);
    }

    [JSInvokable]
    public async Task OnConnectionRestored()
    {
        isOffline = false;
        await SynchronizePending();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SynchronizePending()
    {
        var result = await OfflineQueue.SynchronizeAsync();
        pendingInvoices = result.Remaining;
        if (result.Synchronized > 0)
        {
            statusMessage = $"Se sincronizaron {result.Synchronized} factura(s) pendientes.";
            isError = false;
        }
    }

    private async Task OnTerminalChanged()
    {
        await LoadPaymentMethods();
    }

    private async Task LoadPaymentMethods()
    {
        if (terminalId <= 0) return;

        var configured = await InvoiceApi.GetPaymentMethodsAsync(terminalId);
        paymentMethods = configured.Count > 0
            ? configured.Where(method => method.IsActive).ToList()
            : DefaultPaymentMethods();

        if (paymentMethods.Count > 0 && !paymentMethods.Any(method => method.Name == paymentMethod))
        {
            paymentMethod = paymentMethods[0].Name;
        }
    }

    private static List<TerminalPaymentMethod> DefaultPaymentMethods() => new()
    {
        new() { Code = "cash", Name = "Efectivo" },
        new() { Code = "card", Name = "Tarjeta" },
        new() { Code = "transfer", Name = "Transferencia" },
        new() { Code = "mobile", Name = "Pago móvil" },
        new() { Code = "credit", Name = "Crédito" }
    };

    private void SelectItem(ItemUniversal item)
    {
        selectedItem = item;
        selectedQuantity = 1m;
        selectedUnitPrice = PriceInBolivars(item, item.Price);
        statusMessage = string.Empty;
    }

    private async Task HandleScanKeyDown(KeyboardEventArgs args)
    {
        if (args.Key.Equals("Enter", StringComparison.OrdinalIgnoreCase))
        {
            await ScanProduct();
        }
    }

    private Task ScanProduct()
    {
        var code = scanCode.Trim();
        if (string.IsNullOrWhiteSpace(code)) return Task.CompletedTask;

        var item = items.FirstOrDefault(candidate =>
            string.Equals(candidate.Barcode?.Trim(), code, StringComparison.OrdinalIgnoreCase)
            || string.Equals(candidate.SKU.Trim(), code, StringComparison.OrdinalIgnoreCase));

        if (item == null)
        {
            isError = true;
            statusMessage = $"No se encontró un producto con código {code}.";
            scanCode = string.Empty;
            return Task.CompletedTask;
        }

        selectedItem = item;
        selectedQuantity = 1m;
        selectedUnitPrice = PriceInBolivars(item, item.Price);
        AddLine();
        scanCode = string.Empty;
        return Task.CompletedTask;
    }

    private Task AddScannedProduct(string code)
    {
        scanCode = code;
        return ScanProduct();
    }

    private decimal PriceInBolivars(ItemUniversal item, decimal amount)
    {
        if (item.Currency?.Code.Equals("USD", StringComparison.OrdinalIgnoreCase) == true)
        {
            return amount * usdRate;
        }

        return amount;
    }

    private void AddLine()
    {
        if (selectedItem == null) return;

        var existing = invoiceLines.FirstOrDefault(line => line.ItemUniversalId == selectedItem.Id && line.UnitPrice == selectedUnitPrice);
        if (existing != null)
        {
            existing.Quantity += selectedQuantity;
        }
        else
        {
            invoiceLines.Add(new InvoiceLine
            {
                ItemUniversalId = selectedItem.Id,
                Item = selectedItem,
                Code = selectedItem.SKU,
                Description = selectedItem.Name,
                Quantity = selectedQuantity,
                UnitPrice = selectedUnitPrice,
                TaxRate = selectedItem.EffectiveTaxRate,
                CurrencyId = selectedItem.CurrencyId,
                CategoryId = selectedItem.CategoryId,
                ExchangeRate = 1m
            });
        }

        amountReceived = grandTotal;
        statusMessage = $"Agregado: {selectedItem.Name}.";
        isError = false;
        selectedItem = null;
    }

    private void RemoveLine(InvoiceLine line)
    {
        invoiceLines.Remove(line);
        amountReceived = Math.Min(amountReceived, grandTotal);
    }

    private void AddPaymentAmount(decimal amount) => amountReceived += amount;

    private void ClearPayment() => amountReceived = 0m;

    private void ToggleCloseout() => showCloseout = !showCloseout;

    private void CloseSession()
    {
        statusMessage = $"Caja cerrada: {sessionInvoiceCount} factura(s), total {sessionTotal.ToString("N2")}.";
        sessionInvoiceCount = 0;
        sessionTotal = 0m;
        isError = false;
    }

    private async Task SaveInvoice()
    {
        if (!CanSaveInvoice)
        {
            isError = true;
            statusMessage = "Completa el carrito y verifica el monto recibido.";
            return;
        }

        var draft = InvoiceApiService.BuildDraftInvoice(
            terminalId,
            customerAccountId,
            createdByUserId,
            customerName,
            customerDocument,
            invoiceLines.Select(line => new InvoiceApiService.InvoiceLineDraft(
                line.Item ?? new ItemUniversal { Id = line.ItemUniversalId ?? 0, Name = line.Description, SKU = line.Code, TaxRate = line.TaxRate, CurrencyId = line.CurrencyId ?? 1, CategoryId = line.CategoryId ?? 0 },
                line.Quantity,
                line.UnitPrice,
                line.TaxRate,
                line.Discount,
                line.Description)),
            emissionMode,
            bolivarCurrencyId,
            usdRate);

        if (isOffline)
        {
            if (!paymentMethod.Equals("Efectivo", StringComparison.OrdinalIgnoreCase))
            {
                isError = true;
                statusMessage = "Sin conexión solo se permite registrar pagos en efectivo.";
                return;
            }

            draft.Payments.Add(new InvoicePayment
            {
                TerminalId = terminalId,
                MethodCode = "cash",
                MethodName = "Efectivo",
                Amount = amountReceived,
                CurrencyCode = "VES",
                Status = PaymentStatus.Approved,
                ProviderCode = "offline-manual",
                PaidAtUtc = DateTime.UtcNow
            });
            await OfflineQueue.QueueAsync(draft);
            pendingInvoices = await OfflineQueue.CountAsync();
            invoiceLines.Clear();
            amountReceived = 0m;
            selectedItem = null;
            isError = false;
            statusMessage = "Factura guardada offline. Se sincronizará al recuperar conexión.";
            return;
        }

        var providerData = paymentMethod.Equals("Pago móvil", StringComparison.OrdinalIgnoreCase)
            ? System.Text.Json.JsonSerializer.Serialize(new { @ref = mobileReference, order = draft.ClientGuid.ToString("N") })
            : paymentMethod.Equals("Tarjeta", StringComparison.OrdinalIgnoreCase)
                ? System.Text.Json.JsonSerializer.Serialize(new { @ref = debitReference, order = draft.ClientGuid.ToString("N") })
                : draft.ClientGuid.ToString("N");
        var paymentResult = await PaymentApi.ChargeAsync(new PaymentChargeRequest(
            amountReceived,
            "VES",
            paymentMethods.FirstOrDefault(method => method.Name == paymentMethod)?.Code ?? "cash",
            terminalId,
            providerData));

        if (!paymentResult.Approved)
        {
            isError = true;
            statusMessage = paymentResult.ErrorMessage ?? "El punto de venta rechazó el pago.";
            return;
        }

        draft.Payments.Add(new InvoicePayment
        {
            TerminalId = terminalId,
            MethodCode = paymentMethods.FirstOrDefault(method => method.Name == paymentMethod)?.Code ?? "cash",
            MethodName = paymentMethod,
            Amount = amountReceived,
            CurrencyCode = "VES",
            Status = PaymentStatus.Approved,
            ProviderCode = "generic-pos",
            ProviderReference = paymentResult.Reference,
            AuthorizationCode = paymentResult.AuthorizationCode,
            PaidAtUtc = DateTime.UtcNow
        });

        var (success, created, error) = await InvoiceApi.CreateInvoiceAsync(draft);
        if (!success || created == null)
        {
            if (!string.IsNullOrWhiteSpace(paymentResult.Reference))
            {
                await PaymentApi.CancelAsync(paymentResult.Reference);
            }
            isError = true;
            statusMessage = error ?? "No se pudo emitir la factura.";
            return;
        }

        sessionInvoiceCount++;
        sessionTotal += created.Total;
        isError = false;
        statusMessage = $"Factura emitida: {created.Serie}-{created.Number}. Cambio: {change.ToString("N2")}.";
        invoiceLines.Clear();
        amountReceived = 0m;
        selectedItem = null;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (offlineModule != null && onlineWatcherId != null)
                await offlineModule.InvokeVoidAsync("unwatchOnline", onlineWatcherId);
            if (offlineModule != null) await offlineModule.DisposeAsync();
        }
        catch { }
        offlineDotNetRef?.Dispose();
    }
}

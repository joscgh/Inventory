@page "/customer-accounts"
@using Inventory.Core.Classes
@using Inventory.Core.Enums
@using Inventory.RazorLib.Services
@inject CustomerAccountApiService ApiService

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>🧾 Clientes que compran / consumen</h2>
            <p class="text-muted mb-0">Administra los clientes reales del negocio y los usuarios asociados a cada cuenta.</p>
        </div>
        <a class="btn btn-outline-secondary" href="/inventory">← Volver al inventario</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        @(editAccountId == 0 ? "Nuevo cliente" : $"Modificar cuenta #{editAccountId}")
                    </h5>
                    <div class="mb-3">
                        <label class="form-label">Nombre de la cuenta</label>
                        <input class="form-control" @bind="accountForm.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Documento / RIF</label>
                        <input class="form-control" @bind="accountForm.Document" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Dirección</label>
                        <input class="form-control" @bind="accountForm.Address" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Correo</label>
                        <input class="form-control" @bind="accountForm.Email" type="email" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Teléfono</label>
                        <input class="form-control" @bind="accountForm.Phone" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Logo del cliente</label>
                        <InputFile class="form-control" OnChange="OnLogoSelected" accept="image/png,image/jpeg,image/gif,image/webp" />
                        <div class="form-text">PNG, JPG, GIF o WEBP. Máximo 2 MB.</div>

                        @if (pendingLogoPreview != null)
                        {
                            <div class="mt-2">
                                <img src="@pendingLogoPreview" alt="Logo por subir" class="border rounded p-1"
                                     style="max-height: 90px; max-width: 100%;" />
                                <div class="small text-muted mt-1">
                                    Se subirá al guardar.
                                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline"
                                            @onclick="ClearPendingLogo">Descartar</button>
                                </div>
                            </div>
                        }
                        else if (editAccountId != 0 && editAccountHasLogo)
                        {
                            <div class="mt-2">
                                <img src="@ApiService.GetLogoUrl(editAccountId, logoVersion)" alt="Logo actual"
                                     class="border rounded p-1" style="max-height: 90px; max-width: 100%;" />
                                <div class="small text-muted mt-1">
                                    Logo actual.
                                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline text-danger"
                                            @onclick="RemoveLogo">Quitar logo</button>
                                </div>
                            </div>
                        }
                    </div>
                    <button class="btn btn-primary" @onclick="SaveAccount">
                        @(editAccountId == 0 ? "Guardar cuenta" : "Guardar cambios")
                    </button>
                    @if (editAccountId != 0)
                    {
                        <button class="btn btn-outline-secondary ms-2" @onclick="CancelEdit">Cancelar</button>
                    }
                    @if (!string.IsNullOrEmpty(message))
                    {
                        <div class="alert alert-info mt-3">@message</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Lista de clientes</h5>

                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>Logo</th>
                                    <th>Nombre</th>
                                    <th>Email</th>
                                    <th class="text-end">Usuarios</th>
                                    <th class="text-end">Depósitos</th>
                                    <th class="text-end">Tiendas</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var account in customerAccounts)
                                {
                                    <tr>
                                        <td>
                                            @if (account.HasLogo)
                                            {
                                                <img src="@ApiService.GetLogoUrl(account.Id, logoVersion)" alt="Logo de @account.Name"
                                                     class="border rounded" style="height: 32px; width: 32px; object-fit: contain;" />
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>
                                        <td>@account.Name</td>
                                        <td>@account.Email</td>
                                        <td class="text-end">@account.Users.Count</td>
                                        <td class="text-end">@account.Locations.Count(l => l.Type == LocationType.Warehouse)</td>
                                        <td class="text-end">@account.Locations.Count(l => l.Type == LocationType.Store)</td>
                                        <td class="text-end text-nowrap">
                                            <a class="btn btn-sm btn-outline-primary me-2" href="@($"/account-locations?accountId={account.Id}")">Depósitos / Tiendas</a>
                                            <button class="btn btn-sm btn-outline-secondary me-2" @onclick="() => EditAccount(account)">Editar</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAccount(account.Id)">Borrar</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<CustomerAccount> customerAccounts = new();
    private CustomerAccount accountForm = new();
    private string message = string.Empty;
    private int editAccountId = 0;

    // Logo elegido en el formulario pero todavía no subido: se envía al guardar,
    // porque una cuenta nueva no tiene Id hasta que el API la crea.
    private IBrowserFile? pendingLogoFile;
    private string? pendingLogoPreview;
    private bool editAccountHasLogo;

    // Se incrementa tras cada cambio de logo para forzar que el navegador lo vuelva a pedir.
    private int logoVersion = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
    }

    private async Task LoadAccounts()
    {
        customerAccounts = await ApiService.GetAccountsAsync();
    }

    private async Task OnLogoSelected(InputFileChangeEventArgs args)
    {
        message = string.Empty;
        var file = args.File;

        if (file.Size > CustomerAccountApiService.MaxLogoSizeBytes)
        {
            ClearPendingLogo();
            message = "La imagen no puede superar los 2 MB.";
            return;
        }

        pendingLogoFile = file;

        // Vista previa local, sin pasar por el servidor.
        using var stream = file.OpenReadStream(CustomerAccountApiService.MaxLogoSizeBytes);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        pendingLogoPreview = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer.ToArray())}";
    }

    private void ClearPendingLogo()
    {
        pendingLogoFile = null;
        pendingLogoPreview = null;
    }

    private async Task SaveAccount()
    {
        message = string.Empty;
        int accountId;

        if (editAccountId == 0)
        {
            var (success, created, errorMessage) = await ApiService.CreateAccountAsync(accountForm);
            if (!success || created == null)
            {
                message = errorMessage ?? "Error al crear la cuenta. Verifica los datos.";
                return;
            }

            accountId = created.Id;
            message = "Cuenta creada correctamente.";
        }
        else
        {
            accountForm.Id = editAccountId;
            if (!await ApiService.UpdateAccountAsync(accountForm))
            {
                message = "Error al actualizar la cuenta.";
                return;
            }

            accountId = editAccountId;
            message = "Cuenta actualizada correctamente.";
        }

        // La cuenta ya se guardó; si falla el logo lo decimos sin perder ese hecho.
        if (pendingLogoFile != null)
        {
            using var stream = pendingLogoFile.OpenReadStream(CustomerAccountApiService.MaxLogoSizeBytes);
            var (logoSaved, logoError) = await ApiService.UploadLogoAsync(accountId, stream, pendingLogoFile.Name);

            message = logoSaved
                ? $"{message} Logo guardado."
                : $"{message} Pero el logo no se pudo subir: {logoError}";

            if (logoSaved) logoVersion++;
        }

        editAccountId = 0;
        editAccountHasLogo = false;
        accountForm = new CustomerAccount();
        ClearPendingLogo();
        await LoadAccounts();
    }

    private void EditAccount(CustomerAccount account)
    {
        message = string.Empty;
        editAccountId = account.Id;
        editAccountHasLogo = account.HasLogo;
        ClearPendingLogo();

        // Copia sólo los datos de la cuenta: usuarios y ubicaciones se editan aparte.
        accountForm = new CustomerAccount
        {
            Id = account.Id,
            Name = account.Name,
            Document = account.Document,
            Address = account.Address,
            Email = account.Email,
            Phone = account.Phone
        };
    }

    private async Task RemoveLogo()
    {
        if (editAccountId == 0) return;

        if (await ApiService.DeleteLogoAsync(editAccountId))
        {
            editAccountHasLogo = false;
            logoVersion++;
            message = "Logo eliminado.";
            await LoadAccounts();
        }
        else
        {
            message = "No se pudo eliminar el logo.";
        }
    }

    private void CancelEdit()
    {
        editAccountId = 0;
        editAccountHasLogo = false;
        accountForm = new CustomerAccount();
        ClearPendingLogo();
        message = string.Empty;
    }

    private async Task DeleteAccount(int id)
    {
        await ApiService.DeleteAccountAsync(id);
        if (editAccountId == id) CancelEdit();
        await LoadAccounts();
    }
}

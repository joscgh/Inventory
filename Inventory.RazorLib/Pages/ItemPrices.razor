@page "/inventory/prices/{sku}"
@using Inventory.Core.Classes
@inject Inventory.RazorLib.Services.ItemApiService ItemService

<div class="container mt-4">
    <h3>Precios del producto: @sku</h3>

    @if (item == null)
    {
        <p>Cargando...</p>
    }
    else
    {
        <div class="mb-3">
            <strong>@item.Name</strong> <span class="badge bg-secondary">@item.SKU</span>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Label</th>
                    <th>Amount</th>
                    <th>Currency</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in item.PriceVariants)
                {
                    <tr>
                        <td>@p.Label</td>
                        <td>@p.Amount</td>
                        <td>@(item.Currency?.Code ?? string.Empty)</td>
                        <td>
                            <div class="btn-group">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => AdjustPrice(p, -1)">-</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => AdjustPrice(p, 1)">+</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <button class="btn btn-primary" @onclick="SaveChanges">Guardar cambios</button>
            <a class="btn btn-secondary ms-2" href="/inventory">Cancelar</a>
        </div>
    }
</div>

@code {
    [Parameter] public string sku { get; set; } = string.Empty;
    private ItemUniversal? item;

    protected override async Task OnInitializedAsync()
    {
        item = await ItemService.GetItemBySkuAsync(sku);
        if (item == null) return;
    }

    private void AdjustPrice(PriceVariant p, decimal delta)
    {
        p.Amount += delta;
        if (p.Amount < 0) p.Amount = 0;
    }

    private async Task SaveChanges()
    {
        if (item == null) return;
        var ok = await ItemService.UpdateItemAsync(item);
        if (ok)
        {
            // navigate back or show success - simple reload
            item = await ItemService.GetItemBySkuAsync(sku);
        }
    }
}

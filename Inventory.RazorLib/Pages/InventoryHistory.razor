@page "/inventory/history"
@using Inventory.Core.Classes
@inject Inventory.RazorLib.Services.AdjustmentApiService AdjustmentService

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📜 Historial de inventario</h2>
        <a class="btn btn-secondary" href="/inventory">← Volver al inventario</a>
    </div>

    @if (adjustments == null)
    {
        <p>Cargando...</p>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-sm-6 mb-2">
                <input class="form-control" placeholder="Buscar por SKU, producto, motivo o referencia..." @bind="searchTerm" @bind:event="oninput" />
            </div>
            <div class="col-sm-3 mb-2">
                <select class="form-select" @bind="reasonFilter">
                    <option value="">Todos los motivos</option>
                    @foreach (var r in Reasons)
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </div>
            <div class="col-sm-3 text-sm-end align-self-center">
                <small class="text-muted">Movimientos: @FilteredAdjustments.Count()</small>
            </div>
        </div>

        @if (!FilteredAdjustments.Any())
        {
            <div class="alert alert-info">No hay movimientos de inventario que coincidan.</div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Fecha</th>
                                    <th>SKU</th>
                                    <th>Producto</th>
                                    <th class="text-end">Cambio</th>
                                    <th class="text-end">Anterior</th>
                                    <th class="text-end">Nuevo</th>
                                    <th>Motivo</th>
                                    <th class="d-none d-md-table-cell">Referencia</th>
                                    <th class="d-none d-lg-table-cell">Usuario</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in PagedAdjustments)
                                {
                                    <tr class="text-nowrap">
                                        <td>@a.Timestamp.ToLocalTime().ToString("g")</td>
                                        <td><span class="badge bg-secondary">@a.SKU</span></td>
                                        <td><strong>@(a.Item?.Name ?? "-")</strong></td>
                                        <td class="text-end">
                                            <span class="badge @(a.Change >= 0 ? "bg-success" : "bg-danger")">
                                                @(a.Change > 0 ? $"+{a.Change}" : a.Change.ToString())
                                            </span>
                                        </td>
                                        <td class="text-end text-muted">@a.PreviousStock</td>
                                        <td class="text-end"><strong>@a.NewStock</strong></td>
                                        <td>@a.Reason</td>
                                        <td class="d-none d-md-table-cell">
                                            @if (!string.IsNullOrWhiteSpace(a.ReferenceType) || !string.IsNullOrWhiteSpace(a.ReferenceId))
                                            {
                                                <span class="text-muted">@a.ReferenceType@(string.IsNullOrWhiteSpace(a.ReferenceId) ? "" : ": " + a.ReferenceId)</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="d-none d-lg-table-cell">@(string.IsNullOrWhiteSpace(a.User) ? "-" : a.User)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <div>
                    <label class="form-label me-2">Movimientos por página:</label>
                    <select class="form-select d-inline-block w-auto" @onchange="ChangePageSize">
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                </div>
                <nav>
                    <ul class="pagination mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")"><a class="page-link" href="#" @onclick="PrevPage" @onclick:preventDefault>«</a></li>
                        @for (int p = 1; p <= TotalPages; p++)
                        {
                            var pageNum = p;
                            <li class="page-item @(currentPage == pageNum ? "active" : "")"><a class="page-link" href="#" @onclick="() => SetPage(pageNum)" @onclick:preventDefault>@pageNum</a></li>
                        }
                        <li class="page-item @(currentPage == TotalPages ? "disabled" : "")"><a class="page-link" href="#" @onclick="NextPage" @onclick:preventDefault>»</a></li>
                    </ul>
                </nav>
            </div>
        }
    }
</div>

@code {
    private List<InventoryAdjustment>? adjustments;
    private string searchTerm = string.Empty;
    private string reasonFilter = string.Empty;
    private int currentPage = 1;
    private int pageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        adjustments = await AdjustmentService.GetAllAdjustmentsAsync();
    }

    private IEnumerable<string> Reasons => adjustments == null
        ? Enumerable.Empty<string>()
        : adjustments
            .Select(a => a.Reason ?? string.Empty)
            .Where(r => !string.IsNullOrWhiteSpace(r))
            .Distinct()
            .OrderBy(r => r);

    private IEnumerable<InventoryAdjustment> FilteredAdjustments
    {
        get
        {
            if (adjustments == null) return Enumerable.Empty<InventoryAdjustment>();

            var query = adjustments.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(reasonFilter))
                query = query.Where(a => a.Reason == reasonFilter);

            if (!string.IsNullOrWhiteSpace(searchTerm))
                query = query.Where(a =>
                    (a.SKU ?? string.Empty).Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                    || (a.Item?.Name ?? string.Empty).Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                    || (a.Reason ?? string.Empty).Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                    || (a.ReferenceType ?? string.Empty).Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                    || (a.ReferenceId ?? string.Empty).Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

            return query;
        }
    }

    private IEnumerable<InventoryAdjustment> PagedAdjustments =>
        FilteredAdjustments.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private int TotalPages
    {
        get
        {
            var count = FilteredAdjustments.Count();
            return count == 0 ? 1 : (int)Math.Ceiling(count / (double)pageSize);
        }
    }

    private void SetPage(int p)
    {
        if (p < 1) p = 1;
        if (p > TotalPages) p = TotalPages;
        currentPage = p;
    }

    private void PrevPage()
    {
        if (currentPage > 1) currentPage--;
    }

    private void NextPage()
    {
        if (currentPage < TotalPages) currentPage++;
    }

    private void ChangePageSize(ChangeEventArgs e)
    {
        if (int.TryParse(e?.Value?.ToString(), out var v) && v > 0)
        {
            pageSize = v;
            currentPage = 1;
        }
    }
}

@page "/taxes"
@using Inventory.Core.Classes
@using Inventory.SharedUI.Services
@inject TaxApiService TaxService

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title">🧾 Administrar impuestos</h3>
                    <p class="text-muted">Crea y administra impuestos que se pueden aplicar a los productos del inventario.</p>

                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input class="form-control" @bind="taxModel.Name" placeholder="IVA" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tasa (%)</label>
                        <input type="number" step="0.01" class="form-control" @bind="taxModel.Rate" min="0" max="100" />
                    </div>

                    <button class="btn btn-primary" @onclick="SaveTax">Guardar impuesto</button>

                    @if (!string.IsNullOrEmpty(message))
                    {
                        <div class="alert @messageClass mt-3" role="alert">
                            @message
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title">Impuestos existentes</h3>
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Tasa</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!taxes.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-muted">Todavía no hay impuestos guardados.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var tax in taxes)
                                    {
                                        <tr>
                                            <td>@tax.Name</td>
                                            <td>@tax.Rate.ToString("N2")%</td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-secondary me-2" @onclick="() => EditTax(tax)">Editar</button>
                                                <button class="btn btn-danger btn-sm" @onclick="() => DeleteTax(tax.Id)">Eliminar</button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Tax> taxes = new();
    private Tax taxModel = new();
    private string message = string.Empty;
    private string messageClass = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadTaxes();
    }

    private async Task LoadTaxes()
    {
        taxes = await TaxService.GetTaxesAsync();
        message = string.Empty;
    }

    private async Task SaveTax()
    {
        message = string.Empty;
        messageClass = string.Empty;

        if (string.IsNullOrWhiteSpace(taxModel.Name) || taxModel.Rate < 0 || taxModel.Rate > 100)
        {
            message = "Escribe un nombre de impuesto válido y una tasa entre 0 y 100.";
            messageClass = "alert alert-warning";
            return;
        }

        var success = await TaxService.SaveTaxAsync(taxModel);
        if (success)
        {
            message = "El impuesto se guardó correctamente.";
            messageClass = "alert alert-success";
            taxModel = new Tax();
            await LoadTaxes();
        }
        else
        {
            message = "No se pudo guardar el impuesto. Es posible que ya exista.";
            messageClass = "alert alert-danger";
        }
    }

    private void EditTax(Tax tax)
    {
        taxModel = new Tax
        {
            Id = tax.Id,
            Name = tax.Name,
            Rate = tax.Rate
        };
    }

    private async Task DeleteTax(int id)
    {
        var success = await TaxService.DeleteTaxAsync(id);
        if (success)
        {
            await LoadTaxes();
        }
        else
        {
            message = "No se pudo eliminar el impuesto.";
            messageClass = "alert alert-danger";
        }
    }
}

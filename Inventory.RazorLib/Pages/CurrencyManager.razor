@page "/currencies"
@using Inventory.Core.Classes
@using Inventory.RazorLib.Services
@inject CurrencyApiService CurrencyService

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title">🪙 Manage Currencies</h3>
                    <p class="text-muted">Here you can add currencies that items can use.</p>

                    <div class="mb-3">
                        <label class="form-label">Code</label>
                        <input class="form-control" @bind="newCurrency.Code" placeholder="USD" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input class="form-control" @bind="newCurrency.Name" placeholder="US Dollar" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Symbol</label>
                        <input class="form-control" @bind="newCurrency.Symbol" placeholder="$" />
                    </div>

                    <button class="btn btn-primary" @onclick="SaveCurrency">Save Currency</button>

                    @if (!string.IsNullOrEmpty(message))
                    {
                        <div class="alert @messageClass mt-3" role="alert">
                            @message
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="card-title">Existing Currencies</h3>
                        <button class="btn btn-outline-primary btn-sm" @onclick="RefreshRates" disabled="@isRefreshing">
                            @if (isRefreshing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <text>Refreshing...</text>
                            }
                            else
                            {
                                <text>Refresh BCV Rates</text>
                            }
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Name</th>
                                    <th>Symbol</th>
                                    <th>Rate</th>
                                    <th>Last Updated</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!currencies.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-muted">No currencies saved yet.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var currency in currencies)
                                    {
                                        <tr>
                                            <td>@currency.Code</td>
                                            <td>@currency.Name</td>
                                            <td>@currency.Symbol</td>
                                            <td>@(currency.ExchangeRate.HasValue ? currency.ExchangeRate.Value.ToString("N2") : "—")</td>
                                            <td>@(currency.LastUpdated.HasValue ? currency.LastUpdated.Value.ToLocalTime().ToString("g") : "—")</td>
                                            <td>
                                                <button class="btn btn-danger btn-sm" @onclick="() => DeleteCurrency(currency.Id)">Delete</button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Currency> currencies = new();
    private Currency newCurrency = new();
    private string message = string.Empty;
    private string messageClass = string.Empty;
    private bool isRefreshing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrencies();
    }

    private async Task LoadCurrencies()
    {
        currencies = await CurrencyService.GetCurrenciesAsync();
        if (currencies.Any())
        {
            message = string.Empty;
        }
    }

    private async Task SaveCurrency()
    {
        message = string.Empty;
        messageClass = string.Empty;

        if (string.IsNullOrWhiteSpace(newCurrency.Code) || string.IsNullOrWhiteSpace(newCurrency.Name))
        {
            message = "Please enter a currency code and name.";
            messageClass = "alert alert-warning";
            return;
        }

        var success = await CurrencyService.SaveCurrencyAsync(newCurrency);
        if (success)
        {
            message = "Currency saved successfully.";
            messageClass = "alert alert-success";
            newCurrency = new();
            await LoadCurrencies();
        }
        else
        {
            message = "Could not save the currency. It may already exist.";
            messageClass = "alert alert-danger";
        }
    }

    private async Task DeleteCurrency(int id)
    {
        var success = await CurrencyService.DeleteCurrencyAsync(id);
        if (success)
        {
            await LoadCurrencies();
        }
    }

    private async Task RefreshRates()
    {
        isRefreshing = true;
        message = string.Empty;
        messageClass = string.Empty;

        var success = await CurrencyService.RefreshExchangeRatesAsync();
        if (success)
        {
            message = "Exchange rates updated successfully from BCV.";
            messageClass = "alert alert-success";
            await LoadCurrencies();
        }
        else
        {
            message = "Could not refresh exchange rates. Please try again later.";
            messageClass = "alert alert-danger";
        }

        isRefreshing = false;
    }
}

@page "/nota-pedido"
@using Inventory.Core.Classes
@using Inventory.Core.Enums
@using Inventory.Core.Services
@using Inventory.SharedUI.Services
@using Inventory.RazorLib.Components
@using Microsoft.JSInterop
@inject ItemApiService ApiService
@inject NoteApiService NoteApi
@inject CustomerAccountApiService AccountApi
@inject UserStateService UserState
@inject IJSRuntime JSRuntime

<div class="container-fluid mt-4">
    <div class="page-header mb-4">
        <div class="page-title-block">
            <h2 class="mb-2">📄 Nota de Pedido</h2>
            <p class="text-muted mb-0">Presupuesto de compra / oferta con precio estimado y vigencia.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-secondary" href="/inventory">← Volver al inventario</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Datos de presupuesto</h5>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label">Número de presupuesto</label>
                            <input class="form-control" @bind="quoteNumber" readonly />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Fecha</label>
                            <input type="date" class="form-control" @bind="issueDate" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Cuenta comercial / empresa (opcional)</label>
                            <select class="form-select" @onchange="OnCustomerAccountChanged">
                                <option value="0">Cliente nuevo / seleccionar existente</option>
                                @foreach (var account in accounts)
                                {
                                    <option value="@account.Id">@account.Name - @account.Document</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Almacén / depósito previsto</label>
                            <select class="form-select" @bind="selectedWarehouseId">
                                <option value="0">Seleccione un depósito</option>
                                @foreach (var warehouse in warehouses)
                                {
                                    <option value="@warehouse.Id">@warehouse.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Tienda que emite</label>
                            <select class="form-select" @bind="selectedStoreId">
                                <option value="0">Seleccione una tienda</option>
                                @foreach (var store in stores)
                                {
                                    <option value="@store.Id">@store.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Cliente que compra / consume</label>
                            <input class="form-control" @bind="customerName" placeholder="Nombre del cliente" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Documento</label>
                            <input class="form-control" @bind="customerDocument" placeholder="Cédula / RIF / NIT" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Correo</label>
                            <input class="form-control" @bind="customerEmail" type="email" placeholder="Correo del cliente" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Dirección</label>
                            <textarea class="form-control" @bind="customerAddress" rows="2" placeholder="Dirección del cliente"></textarea>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Teléfono</label>
                            <input class="form-control" @bind="customerPhone" placeholder="Teléfono del cliente" />
                        </div>
                        <div class="col-sm-6 d-flex align-items-end">
                            <button class="btn btn-outline-primary w-100" @onclick="SaveCustomerAccount">Guardar cliente comprador</button>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Vigencia</label>
                            <input type="text" class="form-control" @bind="validityPeriod" placeholder="Ej. 15 días" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Condiciones</label>
                            <textarea class="form-control" @bind="conditions" rows="2" placeholder="Ej. Precios sujetos a disponibilidad."></textarea>
                        </div>
                        <div class="col-12">
                            <div class="alert alert-light border mb-0 py-2">
                                <small class="text-muted">Los clientes que compran/consumen el servicio se registran aquí. Los usuarios que administran la cuenta deben gestionarse en la sección de usuarios.</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="card-body">
                    <h5 class="card-title">Agregar producto</h5>

                    <div class="mb-3">
                        <label class="form-label">Escanear código de barras</label>
                        <div class="input-group">
                            <input class="form-control" placeholder="Escanea o escribe el código y presiona Enter"
                                   @bind="barcodeInput" @bind:event="oninput" @onkeydown="OnBarcodeKeyDown" />
                            <button class="btn btn-outline-primary" type="button" @onclick="AddByBarcodeInput">Agregar por código</button>
                        </div>
                        <BarcodeScanner OnScanned="AddByBarcode" />
                    </div>

                    <div class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label">Producto</label>
                            <select class="form-select" @onchange="OnItemSelected">
                                <option value="">Seleccione un producto</option>
                                @foreach (var item in items)
                                {
                                    <option value="@item.SKU">@item.Name (@item.SKU)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Cantidad</label>
                            <input type="number" min="0.01" step="0.01" class="form-control" @bind="selectedQuantity" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Precio unitario</label>
                            <input type="number" min="0" step="0.01" class="form-control" @bind="selectedUnitPrice" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">% IVA</label>
                            <input class="form-control" readonly @bind="selectedTaxRate" />
                        </div>
                        <div class="col-12 text-md-end">
                            <button class="btn btn-primary w-100 w-md-auto" @onclick="AddLineItem" disabled="@(!CanAddItem)">Agregar a presupuesto</button>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(itemMessage))
                    {
                        <div class="alert alert-warning mt-3">@itemMessage</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6 note-print-area">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title d-print-none">Vista previa de presupuesto</h5>

                    <div class="d-flex align-items-start gap-3 border-bottom pb-3 mb-3">
                        @if (issuerAccount?.HasLogo == true)
                        {
                            <img src="@AccountApi.GetLogoUrl(issuerAccount.Id)" alt="Logo de @issuerAccount.Name"
                                 style="max-height: 70px; max-width: 160px; object-fit: contain;" />
                        }
                        <div class="flex-grow-1">
                            <h5 class="mb-1">@(issuerAccount?.Name ?? "Nota de Pedido")</h5>
                            @if (issuerAccount != null)
                            {
                                @if (!string.IsNullOrWhiteSpace(issuerAccount.Document))
                                {
                                    <div class="small text-muted">RIF: @issuerAccount.Document</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(issuerAccount.Address))
                                {
                                    <div class="small text-muted">@issuerAccount.Address</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(issuerAccount.Phone))
                                {
                                    <div class="small text-muted">Tlf: @issuerAccount.Phone</div>
                                }
                            }
                        </div>
                        <div class="text-end">
                            <div class="fw-bold">NOTA DE PEDIDO</div>
                            <div class="small">@quoteNumber</div>
                            <div class="small text-muted">@issueDate.ToString("dd/MM/yyyy")</div>
                            @if (SelectedWarehouseName != null)
                            {
                                <div class="small text-muted">Depósito: @SelectedWarehouseName</div>
                            }
                            @if (SelectedStoreName != null)
                            {
                                <div class="small text-muted">Tienda: @SelectedStoreName</div>
                            }
                        </div>
                    </div>

                    <div class="alert alert-info">Este documento es un presupuesto. No constituye factura.</div>

                    @if (!lineItems.Any())
                    {
                        <div class="alert alert-info">Agrega productos para generar la nota de pedido.</div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <div class="small text-muted text-uppercase">Cliente</div>
                            <div class="fw-bold">@(string.IsNullOrWhiteSpace(customerName) ? "Sin especificar" : customerName)</div>
                            @if (!string.IsNullOrWhiteSpace(customerDocument))
                            {
                                <div class="small">Documento: @customerDocument</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(customerAddress))
                            {
                                <div class="small">@customerAddress</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(customerPhone))
                            {
                                <div class="small">Tlf: @customerPhone</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(validityPeriod))
                            {
                                <div class="small mt-1">Validez de la oferta: <strong>@validityPeriod</strong></div>
                            }
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th class="text-end">Cant.</th>
                                        <th class="text-end">P. Unit.</th>
                                        <th class="text-end">% IVA</th>
                                        <th class="text-end">Impuesto (Bs)</th>
                                        <th class="text-end">Subtotal (Bs)</th>
                                        <th class="text-end">Total (Bs)</th>
                                        <th class="d-print-none"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in lineItems)
                                    {
                                        <tr>
                                            <td>@line.Description</td>
                                            <td class="text-end">@line.Quantity</td>
                                            <td class="text-end">@FormatOriginal(line)</td>
                                            <td class="text-end">@line.TaxRate.ToString("N2")%</td>
                                            <td class="text-end">@line.TaxAmountBs.ToString("N2")</td>
                                            <td class="text-end">@line.SubtotalBs.ToString("N2")</td>
                                            <td class="text-end">@line.TotalBs.ToString("N2")</td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-danger d-print-none" @onclick="() => RemoveLineItem(line)">Eliminar</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-4">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal (Bs)</span>
                                <strong>Bs @SubtotalBs.ToString("N2")</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Total impuestos (Bs)</span>
                                <strong>Bs @TotalTaxBs.ToString("N2")</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="fw-bold">Total estimado (Bs)</span>
                                <strong>Bs @GrandTotalBs.ToString("N2")</strong>
                            </div>
                            <div class="d-flex justify-content-between text-muted">
                                <small>Tasa aplicada</small>
                                <small>Bs @AppliedRate.ToString("N2") por @(NoteCurrency?.Code ?? "Bs")</small>
                            </div>
                        </div>

                        <div class="mt-4 d-flex flex-wrap gap-2 justify-content-end d-print-none">
                            <button class="btn btn-secondary" @onclick="SaveNote">Guardar presupuesto</button>
                            <button class="btn btn-success" @onclick="PrintNote">Generar PDF</button>
                            <button class="btn btn-outline-success" @onclick="ShareByWhatsapp" disabled="@(!lineItems.Any())">📲 Compartir por WhatsApp</button>
                        </div>
                        @if (!string.IsNullOrEmpty(saveMessage))
                        {
                            <div class="alert @saveMessageClass mt-3 d-print-none">@saveMessage</div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ItemUniversal> items = new();
    private List<CustomerAccount> accounts = new();
    private List<LineItem> lineItems = new();
    private List<AccountLocation> warehouses = new();
    private List<AccountLocation> stores = new();
    private int selectedWarehouseId;
    private int selectedStoreId;

    // Cuenta que emite el presupuesto (la del usuario conectado): aporta el logo y el membrete.
    private CustomerAccount? issuerAccount;

    private string? SelectedWarehouseName =>
        warehouses.FirstOrDefault(w => w.Id == selectedWarehouseId)?.Name;

    private string? SelectedStoreName =>
        stores.FirstOrDefault(s => s.Id == selectedStoreId)?.Name;

    private string quoteNumber = string.Empty;
    private DateTime issueDate = DateTime.Today;
    private int selectedCustomerAccountId;
    private string customerName = string.Empty;
    private string customerDocument = string.Empty;
    private string customerAddress = string.Empty;
    private string customerEmail = string.Empty;
    private string customerPhone = string.Empty;
    private string validityPeriod = "15 días";
    private string conditions = "Precios sujetos a disponibilidad y cambios sin previo aviso.";
    private string selectedSku = string.Empty;
    private decimal selectedQuantity = 1;
    private decimal selectedUnitPrice = 0;
    private decimal selectedTaxRate = 0;
    private string barcodeInput = string.Empty;
    private string itemMessage = string.Empty;

    private bool CanAddItem => !string.IsNullOrWhiteSpace(selectedSku) && selectedQuantity > 0 && selectedUnitPrice >= 0;

    protected override async Task OnInitializedAsync()
    {
        quoteNumber = GenerateQuoteNumber("PED");
        items = await ApiService.GetItemsAsync();
        await LoadCustomerAccounts();
        await LoadLocations();
    }

    /// <summary>
    /// Depósitos y tiendas de la cuenta del usuario conectado. Si hay uno solo de
    /// cada tipo se preselecciona, que es el caso normal.
    /// </summary>
    private async Task LoadLocations()
    {
        var currentUser = await UserState.GetCurrentUserAsync();
        if (currentUser == null) return;

        issuerAccount = await AccountApi.GetAccountByIdAsync(currentUser.AccountId);

        var locations = await AccountApi.GetLocationsAsync(currentUser.AccountId);
        warehouses = locations.Where(l => l.Type == LocationType.Warehouse).ToList();
        stores = locations.Where(l => l.Type == LocationType.Store).ToList();

        if (warehouses.Count == 1) selectedWarehouseId = warehouses[0].Id;
        if (stores.Count == 1) selectedStoreId = stores[0].Id;
    }

    private async Task OnItemSelected(ChangeEventArgs args)
    {
        selectedSku = args?.Value?.ToString() ?? string.Empty;
        var item = items.FirstOrDefault(i => i.SKU == selectedSku);
        if (item != null)
        {
            selectedUnitPrice = item.Price;
            selectedTaxRate = item.EffectiveTaxRate;
            selectedQuantity = 1;
        }
        else
        {
            selectedUnitPrice = 0;
            selectedTaxRate = 0;
            selectedQuantity = 1;
        }
        itemMessage = string.Empty;
        await Task.CompletedTask;
    }

    private async Task OnBarcodeKeyDown(KeyboardEventArgs args)
    {
        // Los lectores de código de barras envían un Enter al terminar la lectura.
        if (args.Key == "Enter")
        {
            await AddByBarcodeInput();
        }
    }

    private async Task AddByBarcodeInput()
    {
        await AddByBarcode(barcodeInput);
    }

    private Task AddByBarcode(string? code)
    {
        itemMessage = string.Empty;
        code = code?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(code))
        {
            itemMessage = "Ingresa o escanea un código.";
            return Task.CompletedTask;
        }

        // Validamos contra la tabla de items: primero por código de barras y luego por SKU.
        var item = items.FirstOrDefault(i =>
                       !string.IsNullOrWhiteSpace(i.Barcode)
                       && string.Equals(i.Barcode, code, StringComparison.OrdinalIgnoreCase))
                   ?? items.FirstOrDefault(i => string.Equals(i.SKU, code, StringComparison.OrdinalIgnoreCase));

        if (item == null)
        {
            itemMessage = $"No existe ningún producto con el código \"{code}\".";
            return Task.CompletedTask;
        }

        // Si ya está en el presupuesto, sumamos una unidad en vez de duplicar la línea.
        var existing = lineItems.FirstOrDefault(l => l.ItemId == item.Id);
        if (existing != null)
        {
            existing.Quantity += 1;
        }
        else
        {
            lineItems.Add(new LineItem
            {
                ItemId = item.Id,
                CategoryId = item.CategoryId,
                CurrencyId = item.CurrencyId,
                Currency = item.Currency,
                Description = item.Name,
                Quantity = 1,
                UnitPrice = item.Price,
                TaxRate = item.EffectiveTaxRate
            });
        }

        barcodeInput = string.Empty;
        return Task.CompletedTask;
    }

    private void AddLineItem()
    {
        itemMessage = string.Empty;

        if (!CanAddItem)
        {
            itemMessage = "Selecciona un producto válido y una cantidad mayor a cero.";
            return;
        }

        var item = items.FirstOrDefault(i => i.SKU == selectedSku);
        if (item == null)
        {
            itemMessage = "No se encontró el producto seleccionado.";
            return;
        }

        lineItems.Add(new LineItem
        {
            ItemId = item.Id,
            CategoryId = item.CategoryId,
            CurrencyId = item.CurrencyId,
            Currency = item.Currency,
            Description = item.Name,
            Quantity = selectedQuantity,
            UnitPrice = selectedUnitPrice,
            TaxRate = item.EffectiveTaxRate
        });

        selectedSku = string.Empty;
        selectedQuantity = 1;
        selectedUnitPrice = 0;
    }

    private string saveMessage = string.Empty;
    private string saveMessageClass = string.Empty;

    private async Task SaveNote()
    {
        saveMessage = string.Empty;
        saveMessageClass = string.Empty;

        var currentUser = await UserState.GetCurrentUserAsync();
        if (currentUser == null)
        {
            saveMessage = "Debe iniciar sesión para guardar el presupuesto.";
            saveMessageClass = "alert-danger";
            return;
        }

        if (!lineItems.Any())
        {
            saveMessage = "Debe agregar al menos un producto al presupuesto.";
            saveMessageClass = "alert-warning";
            return;
        }

        var note = new Note
        {
            Type = NoteType.Pedido,
            NoteNumber = quoteNumber,
            IssueDate = DateTime.SpecifyKind(issueDate, DateTimeKind.Utc),
            CustomerName = customerName,
            CustomerDocument = customerDocument,
            CustomerAddress = customerAddress,
            Notes = conditions,
            ValidityPeriod = validityPeriod,
            Conditions = conditions,
            CurrencyId = NoteCurrency?.Id,
            ExchangeRate = AppliedRate,
            CustomerAccountId = selectedCustomerAccountId > 0 ? selectedCustomerAccountId : currentUser.AccountId,
            CreatedByUserId = currentUser.UserId,
            WarehouseId = selectedWarehouseId > 0 ? selectedWarehouseId : null,
            StoreId = selectedStoreId > 0 ? selectedStoreId : null,
            Lines = lineItems.Select(l => new NoteLine
            {
                ItemUniversalId = l.ItemId,
                CategoryId = l.CategoryId,
                CurrencyId = l.CurrencyId,
                Description = l.Description,
                Quantity = l.Quantity,
                UnitPrice = l.UnitPrice,
                TaxRate = l.TaxRate
            }).ToList()
        };

        var (success, errorMessage) = await NoteApi.SaveNoteAsync(note);
        if (success)
        {
            saveMessage = "Presupuesto guardado correctamente.";
            saveMessageClass = "alert-success";
        }
        else
        {
            saveMessage = string.IsNullOrWhiteSpace(errorMessage)
                ? "Ocurrió un error al guardar el presupuesto."
                : $"Ocurrió un error al guardar el presupuesto: {errorMessage}";
            saveMessageClass = "alert-danger";
        }
    }

    private void RemoveLineItem(LineItem line)
    {
        lineItems.Remove(line);
    }

    private async Task PrintNote()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private async Task ShareByWhatsapp()
    {
        if (!lineItems.Any()) return;

        var text = DocumentShareTextBuilder.BuildNoteShareText(
            title: "NOTA DE PEDIDO",
            number: quoteNumber,
            issueDate: issueDate,
            customerName: customerName,
            customerDocument: customerDocument,
            customerAddress: customerAddress,
            notes: conditions,
            warehouseName: SelectedWarehouseName,
            storeName: SelectedStoreName,
            lines: lineItems.Select(l => (l.Description, l.Quantity, l.UnitPrice, l.TaxRate, l.SubtotalBs, l.TotalBs)),
            subtotal: SubtotalBs,
            totalTax: TotalTaxBs,
            grandTotal: GrandTotalBs,
            validityPeriod: validityPeriod);

        var encoded = Uri.EscapeDataString(text);
        var url = $"https://wa.me/?text={encoded}";
        await JSRuntime.InvokeVoidAsync("open", url, "_blank");
    }

    private async Task LoadCustomerAccounts()
    {
        accounts = await AccountApi.GetAccountsAsync();
    }

    private async Task OnCustomerAccountChanged(ChangeEventArgs args)
    {
        selectedCustomerAccountId = int.TryParse(args?.Value?.ToString(), out var accountId) ? accountId : 0;
        if (selectedCustomerAccountId > 0)
        {
            var account = accounts.FirstOrDefault(a => a.Id == selectedCustomerAccountId);
            if (account != null)
            {
                customerName = account.Name;
                customerDocument = account.Document;
                customerAddress = account.Address;
                customerEmail = account.Email;
                customerPhone = account.Phone;
            }
        }
    }

    private async Task SaveCustomerAccount()
    {
        saveMessage = string.Empty;
        saveMessageClass = string.Empty;

        if (string.IsNullOrWhiteSpace(customerName) || string.IsNullOrWhiteSpace(customerDocument))
        {
            saveMessage = "El nombre y el documento del cliente son obligatorios para guardar la cuenta.";
            saveMessageClass = "alert-warning";
            return;
        }

        var account = new CustomerAccount
        {
            Name = customerName,
            Document = customerDocument,
            Address = customerAddress,
            Email = customerEmail,
            Phone = customerPhone
        };

        var (success, createdAccount, errorMessage) = await AccountApi.CreateAccountAsync(account);
        if (success && createdAccount != null)
        {
            selectedCustomerAccountId = createdAccount.Id;
            await LoadCustomerAccounts();
            saveMessage = "Cliente guardado correctamente.";
            saveMessageClass = "alert-success";
        }
        else
        {
            saveMessage = string.IsNullOrWhiteSpace(errorMessage) ? "No se pudo guardar el cliente." : errorMessage;
            saveMessageClass = "alert-danger";
        }
    }

    private static string GenerateQuoteNumber(string prefix)
    {
        return $"{prefix}-{DateTime.Now:yyyyMMddHHmmss}";
    }

    private decimal Subtotal => lineItems.Sum(l => l.Subtotal);
    private decimal TotalTax => lineItems.Sum(l => l.TaxAmount);
    private decimal GrandTotal => lineItems.Sum(l => l.Total);
    private decimal SubtotalBs => lineItems.Sum(l => l.SubtotalBs);
    private decimal TotalTaxBs => lineItems.Sum(l => l.TaxAmountBs);
    private decimal GrandTotalBs => lineItems.Sum(l => l.TotalBs);

    private Currency? NoteCurrency => lineItems.Select(l => l.Currency).FirstOrDefault(c => c != null);
    private decimal AppliedRate => NoteCurrency?.ExchangeRate ?? 1m;

    private static string FormatOriginal(LineItem line)
    {
        var symbol = line.Currency?.Symbol;
        return string.IsNullOrWhiteSpace(symbol)
            ? line.UnitPrice.ToString("N2")
            : $"{symbol}{line.UnitPrice.ToString("N2")}";
    }

    private class LineItem
    {
        public int? ItemId { get; set; }
        public int? CategoryId { get; set; }
        public int? CurrencyId { get; set; }
        public Currency? Currency { get; set; }
        public string Description { get; set; } = string.Empty;
        public decimal Quantity { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal TaxRate { get; set; }
        public decimal Subtotal => UnitPrice * Quantity;
        public decimal SubtotalBs => Subtotal * (Currency?.ExchangeRate ?? 1m);
        public decimal TaxAmount => Subtotal * TaxRate / 100;
        public decimal TaxAmountBs => TaxAmount * (Currency?.ExchangeRate ?? 1m);
        public decimal Total => Subtotal + TaxAmount;
        public decimal TotalBs => Total * (Currency?.ExchangeRate ?? 1m);
    }
}

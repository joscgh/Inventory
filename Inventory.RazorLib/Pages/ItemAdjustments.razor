@page "/inventory/adjustments/{sku}"
@using Inventory.Core.Classes
@inject Inventory.RazorLib.Services.AdjustmentApiService AdjustmentService

<div class="container mt-4">
    <h3>Historial de ajustes: @sku</h3>

    @if (adjustments == null)
    {
        <p>Cargando...</p>
    }
    else if (!adjustments.Any())
    {
        <div class="alert alert-info">No hay ajustes registrados para este producto.</div>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Change</th>
                    <th>Previous</th>
                    <th>New</th>
                    <th>Reason</th>
                    <th>Reference</th>
                    <th>User</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in adjustments)
                {
                    <tr>
                        <td>@a.Timestamp.ToLocalTime().ToString("g")</td>
                        <td>@a.Change</td>
                        <td>@a.PreviousStock</td>
                        <td>@a.NewStock</td>
                        <td>@a.Reason</td>
                        <td>@(a.ReferenceType + ": " + a.ReferenceId)</td>
                        <td>@a.User</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="mt-3">
        <a class="btn btn-secondary" href="/inventory">← Volver</a>
    </div>
</div>

@code {
    [Parameter] public string sku { get; set; } = string.Empty;
    private List<InventoryAdjustment>? adjustments;

    protected override async Task OnInitializedAsync()
    {
        adjustments = await AdjustmentService.GetAdjustmentsAsync(sku);
    }
}

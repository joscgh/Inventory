@using Inventory.Core.Classes
@using Inventory.SharedUI.Services
@inject AuthApiService AuthService
@inject UserStateService UserState
@inject NavigationManager Navigation

@* Login y registro compartidos por todas las apps (inventario, facturación/POS).
   Cada app lo envuelve en su propia página /login y le pasa a dónde ir después
   de autenticarse y con qué texto presentarse. *@

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden auth-card">
                <div class="row g-0">
                    <div class="col-lg-5 auth-panel d-flex flex-column justify-content-between p-4 p-lg-5">
                        <div>
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white bg-opacity-25 mb-3" style="width: 48px; height: 48px;">
                                <span class="fs-4">@Icon</span>
                            </div>
                            <h3 class="fw-bold text-white mb-2">@(isRegistering ? "Crea tu cuenta" : "Bienvenido de nuevo")</h3>
                            <p class="text-white-50 mb-0">@(isRegistering ? RegisterPitch : LoginPitch)</p>
                        </div>
                        <div class="text-white-50 small">
                            @foreach (var highlight in Highlights)
                            {
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span>●</span>
                                    <span>@highlight</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-lg-7 p-4 p-lg-5">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <h4 class="mb-1">@(isRegistering ? "Crear cuenta" : "Iniciar sesión")</h4>
                                <p class="text-muted mb-0">@(isRegistering ? "Registra tus datos de empresa y usuario." : "Ingresa tus credenciales para acceder.")</p>
                            </div>
                            @if (AllowRegistration)
                            {
                                <button class="btn btn-outline-primary btn-sm" type="button" @onclick="ToggleRegister">
                                    @(isRegistering ? "¿Ya tienes cuenta?" : "¿No tienes cuenta?")
                                </button>
                            }
                        </div>

                        @if (!isRegistering)
                        {
                            <EditForm Model="loginRequest" OnValidSubmit="HandleLogin" class="w-100">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Correo</label>
                                    <InputText class="form-control form-control-lg" @bind-Value="loginRequest.Email" type="email" placeholder="tu@correo.com" autocomplete="email" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Contraseña</label>
                                    <InputText class="form-control form-control-lg" @bind-Value="loginRequest.Password" type="password" placeholder="••••••••" autocomplete="current-password" />
                                </div>
                                <button type="submit" class="btn btn-primary btn-lg w-100">Ingresar</button>
                            </EditForm>
                        }
                        else
                        {
                            <EditForm Model="registerRequest" OnValidSubmit="HandleRegister" class="w-100">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <h6 class="text-secondary mb-3">Datos de la cuenta</h6>
                                        <div class="mb-3">
                                            <label class="form-label">Nombre de la cuenta</label>
                                            <InputText class="form-control" @bind-Value="registerRequest.AccountName" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Documento</label>
                                            <InputText class="form-control" @bind-Value="registerRequest.AccountDocument" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Dirección</label>
                                            <InputText class="form-control" @bind-Value="registerRequest.AccountAddress" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Correo de la cuenta</label>
                                            <InputText class="form-control" type="email" @bind-Value="registerRequest.AccountEmail" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Teléfono</label>
                                            <InputText class="form-control" @bind-Value="registerRequest.AccountPhone" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <h6 class="text-secondary mb-3">Datos del usuario</h6>
                                        <div class="mb-3">
                                            <label class="form-label">Nombre completo</label>
                                            <InputText class="form-control" @bind-Value="registerRequest.FullName" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Correo</label>
                                            <InputText class="form-control" type="email" @bind-Value="registerRequest.Email" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Contraseña</label>
                                            <InputText class="form-control" type="password" @bind-Value="registerRequest.Password" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Rol</label>
                                            <InputText class="form-control" @bind-Value="registerRequest.Role" />
                                        </div>
                                        <button type="submit" class="btn btn-primary w-100">Crear cuenta</button>
                                    </div>
                                </div>
                            </EditForm>
                        }

                        @if (!string.IsNullOrEmpty(message))
                        {
                            <div class="alert alert-danger mt-3 mb-0">@message</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .auth-card {
        background: #ffffff;
    }

    .auth-panel {
        background: linear-gradient(135deg, @AccentFrom 0%, @AccentTo 100%);
    }
</style>

@code {
    /// <summary>A dónde navegar tras autenticarse. Cada app tiene su propia pantalla inicial.</summary>
    [Parameter] public string RedirectTo { get; set; } = "/inventory";

    [Parameter] public string Icon { get; set; } = "🔐";

    [Parameter] public string LoginPitch { get; set; } = "Accede con tus credenciales para continuar donde lo dejaste.";

    [Parameter] public string RegisterPitch { get; set; } = "Completa tus datos para empezar a gestionar el inventario.";

    [Parameter] public IReadOnlyList<string> Highlights { get; set; } = new[]
    {
        "Gestión rápida de stock",
        "Control claro de productos y precios"
    };

    /// <summary>El POS no crea cuentas: se instala contra una cuenta que ya existe.</summary>
    [Parameter] public bool AllowRegistration { get; set; } = true;

    [Parameter] public string AccentFrom { get; set; } = "#2563eb";

    [Parameter] public string AccentTo { get; set; } = "#1d4ed8";

    private LoginRequest loginRequest = new();
    private RegisterAccountRequest registerRequest = new();
    private string message = string.Empty;
    private bool isRegistering;

    private void ToggleRegister()
    {
        message = string.Empty;
        isRegistering = !isRegistering;
    }

    private async Task HandleLogin()
    {
        message = string.Empty;
        var result = await AuthService.LoginAsync(loginRequest);
        if (result == null)
        {
            message = "Credenciales inválidas.";
            return;
        }

        await UserState.SetCurrentUserAsync(result);
        Navigation.NavigateTo(RedirectTo, true);
    }

    private async Task HandleRegister()
    {
        message = string.Empty;
        var (result, errorMessage) = await AuthService.RegisterAsync(registerRequest);
        if (result == null)
        {
            message = errorMessage ?? "No se pudo crear la cuenta. Verifica los datos y prueba de nuevo.";
            return;
        }

        await UserState.SetCurrentUserAsync(result);
        Navigation.NavigateTo(RedirectTo, true);
    }
}

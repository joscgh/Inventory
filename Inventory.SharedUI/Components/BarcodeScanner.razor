@using Microsoft.JSInterop
@implements IAsyncDisposable

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
                <strong>Barcode Scanner</strong>
                <div class="form-text">Use the phone or laptop camera to scan codes.</div>
            </div>
            <button type="button" class="btn btn-sm @(isScanning ? "btn-danger" : "btn-primary")" @onclick="ToggleScanner">
                @(isScanning ? "Stop scanner" : "Start scanner")
            </button>
        </div>

        @if (isScanning)
        {
            <div class="ratio ratio-16x9 mb-3">
                <video id="@VideoElementId" autoplay muted playsinline></video>
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-warning mb-0" role="alert">@errorMessage</div>
        }

        @if (!string.IsNullOrEmpty(LastScan))
        {
            <div class="alert alert-success mb-0 mt-2" role="alert">
                Scanned: <strong>@LastScan</strong>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback<string> OnScanned { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private bool isScanning;
    private bool startRequested;
    private string LastScan = string.Empty;
    private string errorMessage = string.Empty;
    private string VideoElementId = $"barcodeVideo_{Guid.NewGuid():N}";
    private IJSObjectReference? module;
    private DotNetObjectReference<BarcodeScanner>? dotNetRef;

    private async Task ToggleScanner()
    {
        if (isScanning)
        {
            await StopScanner();
        }
        else
        {
            // Solo marcamos el estado; el escáner se arranca en OnAfterRenderAsync,
            // cuando el elemento <video> ya existe en el DOM.
            errorMessage = string.Empty;
            LastScan = string.Empty;
            isScanning = true;
            startRequested = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (startRequested)
        {
            startRequested = false;
            await StartScanner();
        }
    }

    private async Task StartScanner()
    {
        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/_content/Inventory.SharedUI/barcodeScanner.js");
            dotNetRef ??= DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("startBarcodeScanner", VideoElementId, dotNetRef);
        }
        catch (Exception ex)
        {
            errorMessage = "No se pudo iniciar el escáner: " + ex.Message;
            isScanning = false;
            StateHasChanged();
        }
    }

    private async Task StopScanner()
    {
        try
        {
            if (module != null)
            {
                await module.InvokeVoidAsync("stopBarcodeScanner", VideoElementId);
            }
        }
        catch
        {
            // Ignorar errores al detener (p. ej. si el módulo aún no cargó).
        }

        isScanning = false;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnBarcodeScanned(string code)
    {
        LastScan = code;
        await StopScanner();
        await OnScanned.InvokeAsync(code);
        StateHasChanged();
    }

    [JSInvokable]
    public void OnScannerError(string message)
    {
        errorMessage = message;
        isScanning = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (module != null)
            {
                await module.InvokeVoidAsync("stopBarcodeScanner", VideoElementId);
                await module.DisposeAsync();
            }
        }
        catch
        {
            // Ignorar errores de limpieza durante el descarte del componente.
        }

        dotNetRef?.Dispose();
    }
}
